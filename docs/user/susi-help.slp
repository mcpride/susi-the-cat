        <native>New project</native>
        <lang id="de" date="20261123194651" status="3">Neues Projekt</lang>
      </row>
      <row id="`Ctrl+O`" created="20261123194613" note="src/shortcuts.md" notereadonly="1">
        <native>`Ctrl+O`</native>
        <lang id="de" date="20261123194651" status="3">`Strg+O`</lang>
      </row>
      <row id="Open project" created="20261123194613" note="src/shortcuts.md" notereadonly="1">
        <native>Open project</native>
        <lang id="de" date="20261123194651" status="3">Projekt öffnen</lang>
      </row>
      <row id="`Ctrl+S`" created="20261123194613" note="src/shortcuts.md" notereadonly="1">
        <native>`Ctrl+S`</native>
        <lang id="de" date="20261123194651" status="3">`Strg+S`</lang>
      </row>
      <row id="Save project" created="20261123194613" note="src/shortcuts.md" notereadonly="1">
        <native>Save project</native>
        <lang id="de" date="20261123194651" status="3">Projekt speichern</lang>
      </row>
      <row id="`Ctrl+F`" created="20261123194613" note="src/shortcuts.md" notereadonly="1">
        <native>`Ctrl+F`</native>
        <lang id="de" date="20261123194651" status="3">`Strg+F`</lang>
      </row>
      <row id="Find (tab _Search results_)" created="20261123194613" note="src/shortcuts.md" notereadonly="1">
        <native>Find (tab _Search results_)</native>
        <lang id="de" date="20261123194651" status="3">Suchen (Reiter _Ergebnisse suchen_)</lang>
      </row>
      <row id="`F5`" created="20261123194613" note="src/shortcuts.md" notereadonly="1">
        <native>`F5`</native>
        <lang id="de" date="20261123194651" status="3">`F5`</lang>
      </row>
      <row id="Scan for changes" created="20261123194613" note="src/shortcuts.md" notereadonly="1">
        <native>Scan for changes</native>
        <lang id="de" date="20261123194651" status="3">Scannen</lang>
      </row>
      <row id="`F9`" created="20261123194613" note="src/shortcuts.md" notereadonly="1">
