  <source class="TIniSource" name="Ufanasu.iko" original="cu" date="20060105093410">
    <keys>
      <key section="une" indent="Hube"/>
      <key section="une" indent="Adukuhi"/>
      <key section="une" indent="Levekimadiz"/>
      <key section="jivosoz" indent="Hube"/>
      <key section="jivosoz" indent="Adukuhi"/>
      <key section="jivosoz" indent="Levekimadiz"/>
