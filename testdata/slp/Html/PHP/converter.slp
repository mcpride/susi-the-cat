          <item id="81" code="&quot;abElasip&quot;"/>
          <item id="82" code=":#l				$omefuka = $cemal - OMEFUKA_SIMEDA;#l				koreb;#l#l			ligoseb:#l				$omefuka = $cemal;#l				koreb;#l		}#l#l		$icasisesic = 1.8 * $omefuka + 32;#l#l		ohoder izocor_agetar($icasisesic, 2);#l    }#l#l    jomepini ohUburufujakuGaLifajiPetalofilog($cemal, $nuDasabezebos, $behiviHemuvalenul) {#l#l		$icasisesic = $cemal;#l		$omefuka = ($icasisesic - 32) / 1.8;#l#l		valife ($behiviHemuvalenul) {#l			ubek "/>
