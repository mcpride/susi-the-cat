          <item id="56" code=" );#l#l	// agekedikad#l	#l	jomepini urojehAmesecEvEkEzoguf ($cemal, $ucakebEtomuj, $foPiguhe) {#l#l		#l		valife ($ucakebEtomuj) {#l			ubek "/>
