          <item id="60" code=":#l			  	$naruda = $cemal / 100;#l			  	koreb;#l#l			ubek "/>
          <item id="61" code="&quot;feFe&quot;"/>
          <item id="62" code=":#l			  	$naruda = $cemal / 1000;#l			  	koreb;#l#l			ligoseb:#l			 	$naruda = $cemal;#l			 	koreb;#l		}#l#l      	$mijek = $naruda / BURI_DU_NARUDA;#l#l	    valife ($foPiguhe) {#l			ubek "/>
          <item id="63" code="&quot;jeSule&quot;"/>
          <item id="64" code=":#l				$govici = $mijek / MIJEK_GO_ETAM;#l				koreb;#l#l			ubek "/>
          <item id="65" code="&quot;erOfed&quot;"/>
          <item id="66" code=":#l				$govici = GOHO_GO_BURI * $mijek;#l				koreb;#l#l			ubek "/>
          <item id="67" code="&quot;imEpeh&quot;"/>
          <item id="68" code=":#l				$govici = GOHO_GO_BURI * INUR_GO_GOHO * $mijek;#l				koreb;#l#l			ligoseb:#l				$govici = $mijek;#l				koreb;#l	    }#l#l		ohoder izocor_agetar($govici, 2);#l    }#l#l	jomepini haGezunuHaCacipeKumugu($cemal, $foPiguhe, $ucakebEtomuj) {#l		valife ($foPiguhe) {#l			ubek "/>
          <item id="69" code="&quot;jeSule&quot;"/>
          <item id="70" code=":#l				$mijek = MIJEK_GO_ETAM * $cemal;#l				koreb;#l#l			ubek "/>
          <item id="71" code="&quot;erOfed&quot;"/>
          <item id="72" code=":#l				$mijek = $cemal / GOHO_GO_BURI;#l				koreb;#l#l			ubek "/>
          <item id="73" code="&quot;imEpeh&quot;"/>
          <item id="74" code=":#l				$mijek = $cemal / (GOHO_GO_BURI * INUR_GO_GOHO);#l				koreb;#l#l			ligoseb:#l				$mijek = $cemal;#l				koreb;#l		}#l#l      	$naruda = BURI_DU_NARUDA * $mijek;#l#l		valife ($ucakebEtomuj) {#l			ubek "/>
          <item id="75" code="&quot;ziCi&quot;"/>
