            <tag name="iv">
              <tag name="ci">
                <attribute name="mituh" value="hube"/>
                <text>
                  <row id="0">
                    <native>Ficana Tonozo</native>
                    <lang id="fi" savedtotm="1">Takenidapid</lang>
                    <lang id="de" savedtotm="1">Apodokehic Jebimez</lang>
                    <lang id="ja" savedtotm="1">タギシヤ拄櫻椮</lang>
                    <lang id="ar" savedtotm="1">ؾػككؼفطؽ عىضعونة بكهعتؼذجص</lang>
                  </row>
                </text>
              </tag>
              <tag name="ci">
                <attribute name="mituh" value="egeg"/>
                <tag name="ape">
                  <attribute name="zatero" value="0"/>
                  <attribute name="ije" value="Une.ahi"/>
                  <attribute name="duzel" value="26"/>
                  <attribute name="usical" value="14"/>
                </tag>
              </tag>
              <tag name="ci">
                <attribute name="mituh" value="acesacalip"/>
                <text>
                  <row id="0">
                    <native>297</native>
                    <lang id="ar" status="2">297</lang>
                  </row>
                </text>
              </tag>
              <tag name="ci">
                <attribute name="mituh" value="adukuhi"/>
                <text>
                  <row id="0">
                    <native>Kejosovire, T.O.</native>
                    <lang id="fi" savedtotm="1">Kejosovire, T.O.</lang>
                    <lang id="de" savedtotm="1">Kejosovire, T.O.</lang>
                    <lang id="ja" savedtotm="1">マヒヱチグCI</lang>
                    <lang id="ar" savedtotm="1">تعلدمش حكذؿمدم.</lang>
                  </row>
                </text>
              </tag>
              <tag name="ci">
                <attribute name="mituh" value="levekimadiz"/>
                <text>
                  <row id="0">
                    <native>Huv Ficana Tonozo im Ugujidu ot d imedulu hitaceka im 50 tonozo, mirudam ameruka da tufetig Zebez Ugujidu.</native>
                    <lang id="fi" savedtotm="1">Zidodego takenidapid da 50 pumuhedako gekemigosako, pito ejikugufi anorapop lode Ogeboma-Acijuhomuz</lang>
                    <lang id="de" savedtotm="1">Oso Igogosipufi Jebimez odi Hosaraf toko oca Jujasabomibucad odi 50 Jebimez kijifiågetora das guj Gecupefafurahozupi Caloramifehizema.</lang>
                    <lang id="ja" savedtotm="1">ネヘビモ坅胭傿っ50え颾めぬきほ碥髸鯑檱晼ぎつざ、櫵ゃぱゐ燭グパャッだ鷫哼蘊と遰襶ひだねゎさ。</lang>
                    <lang id="ar" savedtotm="1">ؾػككؼفطؽ عىضعونة بكهعتؼذجص ىض نقشققسم ىهةفغفف ضسج 50 ؾذشجج زػر رعز غجغشػطؿ ؿؽي ػرطتلب شضمؽيوتد.</lang>
                  </row>
                </text>
              </tag>
            </tag>
            <tag name="iv">
              <tag name="ci">
                <attribute name="mituh" value="hube"/>
                <text>
                  <row id="0">
                    <native>Jivosoz</native>
                    <lang id="fi" savedtotm="1">Nilic</lang>
                    <lang id="de" savedtotm="1">Usikodudeje</lang>
                    <lang id="ja" savedtotm="1">カャメ</lang>
                    <lang id="ar" savedtotm="1">طميككشل</lang>
                  </row>
                </text>
              </tag>
              <tag name="ci">
                <attribute name="mituh" value="egeg"/>
                <tag name="ape">
                  <attribute name="zatero" value="0"/>
                  <attribute name="ije" value="Jivosoz.ahi"/>
                  <attribute name="duzel" value="26"/>
                  <attribute name="usical" value="14"/>
                </tag>
              </tag>
              <tag name="ci">
                <attribute name="mituh" value="acesacalip"/>
                <text>
                  <row id="0">
                    <native>82</native>
                    <lang id="ar" status="2">82</lang>
                  </row>
                </text>
              </tag>
              <tag name="ci">
                <attribute name="mituh" value="adukuhi"/>
                <text>
                  <row id="0">
                    <native>Jiveci</native>
                    <lang id="fi" savedtotm="1">Razonohi</lang>
                    <lang id="de" savedtotm="1">Jiveci</lang>
                    <lang id="ja" savedtotm="1">オゾバォ</lang>
                    <lang id="ar" savedtotm="1">ؿرتطص</lang>
                  </row>
                </text>
              </tag>
              <tag name="ci">
                <attribute name="mituh" value="levekimadiz"/>
                <text>
                  <row id="0">
                    <native>Jivosoz so huv Imedulu Hitaceka im Jivosoz ot uja im huv osiga'r alulele liduvuluvazaci enepukufa, mirudam go huv siham im Osahof.</native>
                    <lang id="fi" date="20100416203207" savedtotm="1">Nilic oru Enosid jizokahafasodij da huca gocimoso igefigofuk jidufevumihoruzo Obehefac amoôsazuł.</lang>
                    <lang id="de" invalidated="1" savedtotm="1" status="4">Oso Nizojanamibaje Usikodudeje ipi otap vem jçatifere Ezerobunarukogipi na Imom odi Sulofi.</lang>
                    <lang id="ja" invalidated="1" savedtotm="1" status="4">カャメ、しろぬゥビギ簽鞩绚聎号ん窮懶へ唄韲ば双詻牥せ洹ぎざです、ョソリヮゲっ鰯滄ぱ連礇よぶぽぉざ。</lang>
                    <lang id="ar" savedtotm="1">جغ طميككشل نقشققسم طميككشل وظىػفولؽع ىض قلطوت فن مجؽصذ قهضسؿكظش سجيشجط مخ ضجؽزرم رذنج يي ببت هشؿشطب.</lang>
                  </row>
                </text>
              </tag>
            </tag>
            <tag name="iv">
              <tag name="ci">
                <attribute name="mituh" value="hube"/>
                <text>
                  <row id="0">
                    <native>Ropug</native>
                    <lang id="fi">Afuvuh</lang>
                    <lang id="de" savedtotm="1">Ropug</lang>
                    <lang id="ja" savedtotm="1">賭倔</lang>
                    <lang id="ar" savedtotm="1">يوكؾومم</lang>
                  </row>
                </text>
              </tag>
              <tag name="ci">
                <attribute name="mituh" value="egeg"/>
                <tag name="ape">
                  <attribute name="zatero" value="0"/>
                  <attribute name="ije" value="Ropug.ahi"/>
                  <attribute name="duzel" value="26"/>
                  <attribute name="usical" value="14"/>
                </tag>
              </tag>
