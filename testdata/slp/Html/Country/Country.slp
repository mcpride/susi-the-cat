                <attribute name="mituh" value="acesacalip"/>
                <text>
                  <row id="0">
                    <native>127</native>
                    <lang id="ar" status="2">127</lang>
                  </row>
                </text>
              </tag>
              <tag name="ci">
                <attribute name="mituh" value="adukuhi"/>
                <text>
                  <row id="0">
                    <native>Ekoko</native>
                    <lang id="fi">Tumam</lang>
                    <lang id="de" savedtotm="1">Tumam</lang>
                    <lang id="ja" savedtotm="1">鯐鑖</lang>
                    <lang id="ar" savedtotm="1">قجتسن</lang>
                  </row>
                </text>
              </tag>
              <tag name="ci">
                <attribute name="mituh" value="levekimadiz"/>
                <text>
                  <row id="0">
                    <native>Ropug ot d ufanasu da huv ibozemo cato im huv Kiricot Ihako.</native>
                    <lang id="fi" savedtotm="1">Afuvuh da lot Zocami nacuzapuri oçbuzojiborat.</lang>
                    <lang id="de" savedtotm="1">Ropug ipi oca Tela ev edejutolil Zega ega Erefopuloje Agele.</lang>
                    <lang id="ja" savedtotm="1">鼕餁し傯璌雏へ购虫ま彆纳ぴひ屌ずご。</lang>
                    <lang id="ar" savedtotm="1">يوكؾومم بؼغ يةه ؿؽي مضذىث ثيذطؼه فن جصطؾزه قلوعول.</lang>
                  </row>
                </text>
              </tag>
            </tag>
          </tag>
        </tag>
      </tag>
