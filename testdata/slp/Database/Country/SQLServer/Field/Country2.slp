      <node class="TDatabaseStringFieldNode" name="Adukuhi" defaultmaxchars="50">
        <row id="0">Kejosovire, T.O.</row>
        <row id="1">Jiveci</row>
        <row id="2">Ekoko</row>
      </node>
      <node class="TDatabaseStringFieldNode" name="Levekimadiz" defaultmaxchars="200">
        <row id="0">Huv Ficana Tonozo im Ugujidu ot d imedulu hitaceka im 50 tonozo, mirudam ameruka da tufetig Zebez Ugujidu.</row>
        <row id="1">Jivosoz so huv Imedulu Hitaceka im Jivosoz ot uja im huv osiga'r alulele liduvuluvazaci enepukufa, mirudam go huv siham im Osahof.</row>
        <row id="2">Ropug ot d ufanasu da huv ibozemo cato im huv Kiricot Ihako.</row>
      </node>
      <node class="TDatabaseStringFieldNode" name="Hube" defaultmaxchars="50">
