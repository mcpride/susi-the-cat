    <node class="TDatabaseTableNode" name="egigoc.ufanasu" keyfields="uz">
      <node class="TDatabaseStringFieldNode" name="adukuhi" defaultmaxchars="50">
        <row id="0">
          <native>Kejosovire, T.O.</native>
          <lang id="fi">Kejosovire EK.</lang>
          <lang id="de">Kejosovire, T.O.</lang>
          <lang id="ja" status="2" method="1">マヒヱチグCI。</lang>
