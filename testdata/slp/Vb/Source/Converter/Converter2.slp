    <section name="une" created="20160929202253">
      <value created="20160929202253">
        <row id="Hube" note="Hube im huv ufanasu" notereadonly="1">
          <native>Ficana Tonozo</native>
          <lang id="fi" status="2" method="1">Takenidapid</lang>
        </row>
      </value>
      <value name="Acesacalip" created="20160929202253" value="297"/>
      <value created="20160929202253">
        <row id="Adukuhi">
          <native>Kejosovire, T.O.</native>
          <lang id="fi" status="2" method="1">Kejosovire EK.</lang>
        </row>
      </value>
      <value created="20160929202253">
        <row id="Levekimadiz">
          <native>Huv Ficana Tonozo im Ugujidu ot d imedulu hitaceka im 50 tonozo, mirudam ameruka da tufetig Zebez Ugujidu.</native>
          <lang id="fi" status="2" method="1">Zidodego takenidapid da 50 pumuhedako gekemigosako, pito ejikugufi anorapop lode Ogeboma-Acijuhomuz.</lang>
        </row>
      </value>
    </section>
    <section name="jivosoz" created="20160929202253">
      <value created="20160929202253">
        <row id="Hube">
          <native>Jivosoz</native>
          <lang id="fi" status="2" method="1">Nilic</lang>
        </row>
      </value>
      <value name="Acesacalip" created="20160929202253" value="82"/>
      <value created="20160929202253">
        <row id="Adukuhi">
          <native>Jiveci</native>
          <lang id="fi" status="2" method="1">Razonohi</lang>
        </row>
      </value>
      <value created="20160929202253">
        <row id="Levekimadiz">
          <native>Jivosoz so huv Imedulu Hitaceka im Jivosoz ot uja im huv osiga'r alulele liduvuluvazaci enepukufa, mirudam go huv siham im Osahof.</native>
          <lang id="fi" status="2" method="1">Nilic oru Enosid jizokahafasodij da huca gocimoso igefigofuk jidufevumihoruzo Obehefac amoôsazuł.</lang>
        </row>
      </value>
    </section>
    <section name="ropug" created="20160929202253">
      <value created="20160929202253">
        <row id="Hube">
          <native>Ropug</native>
          <lang id="fi" status="2" method="1">Afuvuh</lang>
        </row>
      </value>
      <value name="Acesacalip" created="20160929202253" value="127"/>
      <value created="20160929202253">
        <row id="Adukuhi">
          <native>Ekoko</native>
          <lang id="fi" status="2" method="1">Tumam</lang>
        </row>
      </value>
      <value created="20160929202253">
        <row id="Levekimadiz">
          <native>Ropug ot d ufanasu da huv ibozemo cato im huv Kiricot Ihako.</native>
          <lang id="fi" status="2" method="1">Afuvuh da lot Zocami nacuzapuri oçbuzojiborat.</lang>
        </row>
      </value>
    </section>
  </source>
