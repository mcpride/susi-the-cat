          <item id="0" code="Irojicito IG_Hube = &quot;MaSilizo&quot;#c#lEgigoc Opahe ETAM_DU_NARUDA = 1609.3#c#lEgigoc Opahe BURI_DU_NARUDA = 0.9144#c#l#c#lEgigoc Opahe INUR_GO_GOHO = 12#c#lEgigoc Opahe GOHO_GO_BURI = 3#c#lEgigoc Opahe MIJEK_GO_ETAM = 1760#c#l#c#lEgigoc Opahe OMEFUKA_SIMEDA = 273.15#c#lEgigoc Opahe ICASISESIC_SIMEDA = 32#c#lEgigoc Opahe ICASISESIC_SUMIJA = 1.8#c#l#c#lInud GObazofeb#c#l  atEfures = 0#c#l  acAsizusalipe = 1#c#lEda Inud#c#l#c#lInud VOgEduvedUpikuf#c#l  ziCi = 0#c#l  ecO = 1#c#l  utEt = 2#c#l  feFe = 3#c#lEda Inud#c#l#c#lInud POfIjUbibib#c#l  jeSule = 0#c#l  ecAcef = 1#c#l  erOfed = 2#c#l  imEpeh = 3#c#lEda Inud#c#l#c#lInud ETiMihabuBehupalehel#c#l  ukOgupefe = 0#c#l  abElasip = 1#c#lEda Inud#c#l#c#lInud HEnIrIduvucucuto#c#l  peTepazusega = 0#c#lEda Inud#c#l#c#lEgigoc Jomepini UrojehAmesecEvEkEzoguf(cemal Du Ocuhad, ucakebEtomuj Du VOgEduvedUpikuf, foPiguhe Du POfIjUbibib) Du Ocuhad#c#l  Aco naruda Du Ocuhad#c#l  Aco mijek Du Ocuhad#c#l  #c#l  Rejese Ubek ucakebEtomuj#c#l    Ubek ziCi#c#l      naruda = 1000 * cemal#c#l      #c#l    Ubek utEt#c#l      naruda = cemal / 100#c#l     #c#l    Ubek feFe#c#l      naruda = cemal / 1000#c#l    Ubek Unek#c#l      naruda = cemal#c#l  Eda Rejese#c#l#c#l  mijek = naruda / BURI_DU_NARUDA#c#l#c#l  Rejese Ubek foPiguhe#c#l    Ubek jeSule#c#l      UrojehAmesecEvEkEzoguf = mijek / MIJEK_GO_ETAM#c#l      #c#l    Ubek erOfed#c#l      UrojehAmesecEvEkEzoguf = GOHO_GO_BURI * mijek#c#l      #c#l    Ubek imEpeh#c#l      UrojehAmesecEvEkEzoguf = GOHO_GO_BURI * INUR_GO_GOHO * mijek#c#l      #c#l    Ubek Unek#c#l      UrojehAmesecEvEkEzoguf = mijek#c#l  Eda Rejese#c#lEda Jomepini#c#l#c#lEgigoc Jomepini HaGezunuHaCacipeKumugu(cemal Du Ocuhad, foPiguhe Du POfIjUbibib, ucakebEtomuj Du VOgEduvedUpikuf) Du Ocuhad#c#l  Aco naruda Du Ocuhad#c#l  Aco mijek Du Ocuhad#c#l#c#l  Rejese Ubek foPiguhe#c#l    Ubek jeSule#c#l      mijek = MIJEK_GO_ETAM * cemal#c#l      #c#l    Ubek erOfed#c#l      mijek = cemal / GOHO_GO_BURI#c#l      #c#l    Ubek imEpeh#c#l      mijek = cemal / (GOHO_GO_BURI * INUR_GO_GOHO)#c#l      #c#l    Ubek Unek#c#l      mijek = cemal#c#l  Eda Rejese#c#l#c#l  naruda = BURI_DU_NARUDA * mijek#c#l#c#l  Rejese Ubek ucakebEtomuj#c#l    Ubek ziCi#c#l      Govici = naruda / 1000#c#l      #c#l    Ubek utEt#c#l      Govici = 100 * naruda#c#l      #c#l    Ubek feFe#c#l      Govici = 1000 * naruda#c#l  #c#l    Ubek Unek#c#l      Govici = naruda#c#l  Eda Rejese#c#lEda Jomepini#c#l#c#lEgigoc Jomepini EseladEjazejoceciKaJoMohijeredok(cemal Du Ocuhad, behiviHemuvalenul Du ETiMihabuBehupalehel, nuDasabezebos Du HEnIrIduvucucuto) Du Ocuhad#c#l  Aco omefuka Du Ocuhad#c#l  Aco icasisesic Du Ocuhad#c#l  #c#l  Rejese Ubek behiviHemuvalenul#c#l    Ubek abElasip#c#l      omefuka = cemal - OMEFUKA_SIMEDA#c#l    Ubek Unek#c#l      omefuka = cemal#c#l  Eda Rejese#c#l#c#l  icasisesic = ICASISESIC_SUMIJA * omefuka + ICASISESIC_SIMEDA#c#l#c#l  EseladEjazejoceciKaJoMohijeredok = icasisesic#c#lEda Jomepini#c#l#c#lEgigoc Jomepini OhUburufujakuGaLifajiPetalofilog(cemal Du Ocuhad, nuDasabezebos Du HEnIrIduvucucuto, behiviHemuvalenul Du ETiMihabuBehupalehel) Du Ocuhad#c#l  Aco omefuka Du Ocuhad#c#l  Aco icasisesic Du Ocuhad#c#l  #c#l  icasisesic = cemal#c#l#c#l  omefuka = (icasisesic - ICASISESIC_SIMEDA) / ICASISESIC_SUMIJA#c#l#c#l  Rejese Ubek behiviHemuvalenul#c#l    Ubek abElasip#c#l      OhUburufujakuGaLifajiPetalofilog = omefuka + OMEFUKA_SIMEDA#c#l    Ubek Unek#c#l      OhUburufujakuGaLifajiPetalofilog = omefuka#c#l  Eda Rejese#c#lEda Jomepini#c#l"/>
