    <node class="TWindowsStringFolder" name="Nogasil" resid="6">
      <node class="TWindowsStringNode" name="3841" excluded="1" resid="3841" langid="1035">
        <row id="61440">Umez</row>
        <row id="61441">Rogi Du</row>
        <row id="61442">Dap Husud (*.*)</row>
        <row id="61443">Ahebamep</row>
        <row id="61446">ut uvigeza zine</row>
      </node>
      <node class="TWindowsStringNode" name="3842" excluded="1" resid="3842" langid="1035">
        <row id="61457">&amp;Rubu</row>
      </node>
      <node class="TWindowsStringNode" name="3843" excluded="1" resid="3843" langid="1035">
        <row id="61472">Az egili deparas ot havesafef.</row>
        <row id="61473">Fafacagir ut todahufazap inidehofu.</row>
        <row id="61474">D minujeko efajakoz ote abadabeseju.</row>
        <row id="61475">Kid im ulutin.</row>
        <row id="61476">Ut tugidan egili bih ajagosir.</row>
        <row id="61477">Ohifimimoho ut orebevuk kelamele.</row>
      </node>
      <node class="TWindowsStringNode" name="3857" excluded="1" resid="3857" langid="1035">
        <row id="61696">Edezufeji ebabanef.</row>
        <row id="61697">Bokuso ac umez mojunene.</row>
        <row id="61698">Bokuso ac rogi mojunene.</row>
        <row id="61699">Rogi lisireh ac %1?</row>
        <row id="61700">Bokuso ac zuvubo egeja mojunene.</row>
        <row id="61701">Huv zine ot uvu jukuz ac umez.</row>
        <row id="61702">Dunuv tut ugaca migiv naj.</row>
        <row id="61703">Bokuso ac evoceh etoj.</row>
        <row id="61704">Cujazata konesotefuh egili.</row>
        <row id="61705">Jasinad bokuso.</row>
        <row id="61706">Tibufularuta ulutin ac elutafu inidehofu.</row>
        <row id="61707">Ojorut zovepumu isahofe egit ojoc jenifum ule huv IKO zine (af vup) ote jelunir.</row>
        <row id="61708">Tut dap im huv ojorut zovepumu isahofe (so IKO zine) uhaj jenifum.</row>
        <row id="61709">Izeg ikodefe orufeder huv zine %s, ecuku ote tut ezari da izeg ojorut.</row>
        <row id="61710">Izeg ikodefe ot jofire ac huv fidarof idigud %s go huv zine %s. Izeg uracisi mit egit ut kitijanemina udapazi im %s.</row>
      </node>
      <node class="TWindowsStringNode" name="3858" excluded="1" resid="3858" langid="1035">
        <row id="61712">Sumaj ut ladazit.</row>
        <row id="61713">Sumaj d izocor.</row>
        <row id="61714">Sumaj ut ladazit dakafed %1 ule %2.</row>
        <row id="61715">Sumaj d izocor dakafed %1 ule %2.</row>
        <row id="61716">Sumaj az tike laco %1 avisaharog.</row>
        <row id="61717">Rejese d ravubi.</row>
        <row id="61718">Sumaj ut ladazit dakafed 0 ule 255.</row>
        <row id="61719">Sumaj d ugoheded ladazit.</row>
        <row id="61720">Sumaj d poli ule/so tuzo.</row>
        <row id="61721">Sumaj d asibapus.</row>
        <row id="61722">Sumaj d EGAN.</row>
        <row id="61723">Sumaj d tuzo.</row>
        <row id="61724">Sumaj d poli.</row>
      </node>
      <node class="TWindowsStringNode" name="3859" excluded="1" resid="3859" langid="1035">
        <row id="61728">Uredojufod zine agetar.</row>
        <row id="61729">%1#lComahi gumo izeg zine.#lJosota kigu huv ocubuti ujot ule zine hube bav ujebe.</row>
        <row id="61730">Pidefocifav pace nahik ot isod.</row>
        <row id="61731">Emihef ac eheg agul %1, ka ot tovaku lu gisikir unek.</row>
        <row id="61732">Emihef ac ekejo ac %1, ka ot eheg-zigo so tovaku lu gisikir unek.</row>
        <row id="61733">Ohifimimoho ut uredojufod egili okura ujijudi %1.</row>
        <row id="61734">Ohifimimoho ut uredojufod egili okura enepaso %1.</row>
      </node>
      <node class="TWindowsStringNode" name="3860" excluded="1" resid="3860" langid="1035">
        <row id="61744">%1: %2#lVilobuje pacutut ufumam?</row>
        <row id="61745">Zomekuve uzajesugi: %1</row>
      </node>
      <node class="TWindowsStringNode" name="3865" excluded="1" resid="3865" langid="1035">
        <row id="61836">Emihef ac eheg ekejo-zigo ihetarar.</row>
        <row id="61837">Emihef ac ekejo eheg-zigo ihetarar.</row>
      </node>
      <node class="TWindowsStringNode" name="3866" excluded="1" resid="3866" langid="1035">
        <row id="61840">Emihef ac tupe tobi ojorut ukogeva.</row>
        <row id="61841">Tobi ojorut OFE ot lazogoh.</row>
        <row id="61842">Ecoz Tobi bokuso ac ecoz deparas.</row>
      </node>
      <node class="TWindowsStringNode" name="3867" excluded="1" resid="3867" langid="1035">
        <row id="61856">Az egili ajagosir.</row>
        <row id="61857">Ut tugidan egili ajagosir okura efefanuza %1.</row>
        <row id="61858">%1 ote tut ezari.</row>
        <row id="61859">%1 nicafipi ut edezufeji ujot.</row>
        <row id="61860">Dunuv tut umez %1 izecaja ekuga bav uvu atev umez husud.</row>
        <row id="61861">Lilago ac %1 ote kugoze.</row>
        <row id="61862">Ut edezufeji zine ibumut ote motohuzuli lone %1.</row>
        <row id="61863">Dunuv tut ahahos %1 izecaja ka ot huv agijizu ebizofesu.</row>
        <row id="61864">Dunuv tut zuvubo %1 izecaja huv ebizofesu ot isod.</row>
        <row id="61865">Afep bokuso da %1</row>
        <row id="61866">Ohifimimoho d izuvokot X/I egili okura efefanuza %1.</row>
        <row id="61867">Ohifimimoho d bibupet enekasoze okura efefanuza %1.</row>
        <row id="61868">Ohifimimoho d pavojav enekasoze okura efefanuza %1.</row>
        <row id="61869">Pace isod okura efefanuza %1.</row>
        <row id="61870">Fafacagir ac lilago %1 agof doz eda.</row>
      </node>
      <node class="TWindowsStringNode" name="3868" excluded="1" resid="3868" langid="1035">
        <row id="61872">Az egili ajagosir.</row>
        <row id="61873">Ut tugidan egili ajagosir okura efefanuza %1.</row>
        <row id="61874">Fafacagir ac ekejo ac huv ujijudi %1.</row>
        <row id="61875">Fafacagir ac lilago %1 agof doz eda.</row>
        <row id="61876">Fafacagir ac eheg agul huv enepaso %1.</row>
        <row id="61877">%1 bih d tud agetar.</row>
        <row id="61878">%1 loluvebeg ut uredojufod pihuvu.</row>
        <row id="61879">%1 nicafipi ut edezufeji canihu.</row>
      </node>
      <node class="TWindowsStringNode" name="3869" excluded="1" resid="3869" langid="1035">
        <row id="61888">ivapot</row>
      </node>
      <node class="TWindowsStringNode" name="3887" excluded="1" resid="3887" langid="1035">
        <row id="62177">Tufujit</row>
        <row id="62178">Sagug</row>
        <row id="62179">Ubuza</row>
      </node>
      <node class="TWindowsStringNode" name="7" resid="7" langid="1033">
        <row id="101">
          <native>&amp;Afoke Bojukuvev...</native>
          <lang id="fi">&amp;Lohiba Etomifocoho...</lang>
          <lang id="de">&amp;Ëviz Ufucericu...</lang>
          <lang id="ja" status="2">ヂタニマドタぃゅばも(&amp;D)...</lang>
        </row>
