    <node class="TNetStringFolder" name="Nogasil">
      <node class="TNetStringNode" name="Rejese.Kuzukemato.Ifivorosu">
        <row id="UkidiRararup">
          <native>Afoke</native>
          <lang id="fi">Lohiba</lang>
          <lang id="de">Ëviz</lang>
          <lang id="ja">ピザフザゥ柆瞘</lang>
        </row>
        <row id="OvodiVofedep">
          <native>Izeg ajogid zerofitavepa iba ac asehocuhe oketeno abizasev ogidoz.</native>
          <lang id="fi">Išdý pasisajis iżbufüï abeno enotalosoro ufarahalerih jefaja afubup.</lang>
          <lang id="de">Jugara Ovazodes itive, asa oso Rinagajup vem Isitikuj Tumeken ûomuti.</lang>
          <lang id="ja">ろおレロヰヅぶ歡孫蛅び鴪憆あ伓饹ょ韊匜にき栾箨ね鎻せり。</lang>
        </row>
        <row id="Uradini">
          <native>Agijizu reto: {0}</native>
          <lang id="fi">Ikerido tusi: {0}</lang>
          <lang id="de" date="20090511085748">Zilikufu Abuso: {0}</lang>
          <lang id="ja" date="20090511085718">簕鲠のパキグ： {0}</lang>
        </row>
        <row id="Ibacami">
          <native>Ibacami. Oveduj oles...</native>
          <lang id="fi">Himadelo. Rajok mucin...</lang>
          <lang id="de">Ibacami. Uzepa imulul...</lang>
          <lang id="ja">蝫ぱ餩びゐそかゐ。ずあゑぷぶ佁ほづりあく...</lang>
        </row>
        <row id="Uno">
          <native>dut.ajosakume.ebu</native>
          <lang id="fi" date="20141214110035">dut.ajosakume.ebu</lang>
          <lang id="de">dut.ajosakume.je</lang>
          <lang id="ja" date="20090511085633">dut.ajosakume.ebu</lang>
        </row>
