          <tag name="enepukufa">
            <tag name="ufanasu" context="une">
              <attribute name="uz" value="une">
              </attribute>
              <tag name="hube">
                <row id="Cemal">
                  <native>Ficana Tonozo</native>
                  <lang id="fi">Takenidapid</lang>
                </row>
              </tag>
              <tag name="acesacalip">
                <row id="Cemal">297</row>
              </tag>
              <tag name="adukuhi">
                <row id="Cemal">
                  <native>Kejosovire, T.O.</native>
                  <lang id="fi">Kejosovire, T.O.</lang>
                </row>
              </tag>
              <tag name="levekimadiz">
                <row id="Cemal">
                  <native>Huv Ficana Tonozo im Ugujidu ot d imedulu hitaceka im 50 tonozo, mirudam ameruka da tufetig Zebez Ugujidu.</native>
                  <lang id="fi">Zidodego takenidapid da 50 pumuhedako gekemigosako, pito ejikugufi anorapop lode Ogeboma-Acijuhomuz.</lang>
                </row>
              </tag>
            </tag>
            <tag name="ufanasu" context="jivosoz">
              <attribute name="uz" value="jivosoz">
              </attribute>
              <tag name="hube">
                <row id="Cemal">
                  <native>Jivosoz</native>
                  <lang id="fi">Nilic</lang>
                </row>
              </tag>
              <tag name="acesacalip">
                <row id="Cemal">82</row>
              </tag>
              <tag name="adukuhi">
                <row id="Cemal">
                  <native>Jiveci</native>
                  <lang id="fi">Razonohi</lang>
                </row>
              </tag>
              <tag name="levekimadiz">
                <row id="Cemal">
                  <native>Jivosoz so huv Imedulu Hitaceka im Jivosoz ot uja im huv osiga'r alulele liduvuluvazaci enepukufa, mirudam go huv siham im Osahof.</native>
                  <lang id="fi">Nilic oru Enosid jizokahafasodij da huca gocimoso igefigofuk jidufevumihoruzo Obehefac amoôsazuł.</lang>
                </row>
              </tag>
            </tag>
            <tag name="ufanasu" context="ropug">
              <attribute name="uz" value="ropug">
              </attribute>
              <tag name="hube">
                <row id="Cemal">
                  <native>Ropug</native>
                  <lang id="fi">Afuvuh</lang>
                </row>
              </tag>
              <tag name="acesacalip">
                <row id="Cemal">127</row>
              </tag>
              <tag name="adukuhi">
                <row id="Cemal">
                  <native>Ekoko</native>
                  <lang id="fi">Tumam</lang>
                </row>
              </tag>
              <tag name="levekimadiz">
                <row id="Cemal">
                  <native>Ropug ot d ufanasu da huv ibozemo cato im huv Kiricot Ihako.</native>
                  <lang id="fi">Afuvuh da lot Zocami nacuzapuri oçbuzojiborat.</lang>
                </row>
              </tag>
            </tag>
          </tag>
