    <node class="TNetStringFolder" name="Nogasil">
      <node class="TNetStringNode" name="Bafe1">
        <row id="OVukaKisu.JogelEpujEpici:SEboza">
          <native>Bojukuvev ot ut konesotefuh kigu jodahomo cinulu ugeme ac MO ugeme ule ovun.</native>
          <lang id="fi">Isabunu da alulovo, pito iguduze vazakisusiđlaê RU-jżazemufidîohý MO-zźomojatusășe ed jefosoce.</lang>
          <lang id="ja">チガユラガテき痁鍂げじで簸跑べ、ヤヱクサ盬ねぬナムゴヮタラ筻れ、おがつズゼィットヨ挢うけヌダフゼ柧ぎ蜌矋みゃヘズタバカスグャるて。</lang>
        </row>
        <row id="OVukaKisu.JogelEpujEpici:USadudOheledoba">
          <native>Afoke Bojukuvev</native>
          <lang id="fi">Lohiba Etomifocoho</lang>
          <lang id="ja">ヂタニマドタぃゅばも</lang>
        </row>
        <row id="OVukaKisu.Vusodunevo$AmiTemukare:UFobebo">
          <native>Ivofad</native>
          <lang id="fi">Ukirav</lang>
          <lang id="ja">祆じ</lang>
        </row>
