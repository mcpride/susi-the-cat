    <node class="TWindowsStringFolder" name="Nogasil" resid="6">
      <node class="TWindowsStringNode" name="IVUMuhen" excluded="1" resname="IVUMuhen">
        <row id="TEJADihanoRugav">Egili ijenagun pihuvu.  Oveduj josota kigu huv Fuvabijoz Ehak Lilago Izojajetib 2.1 (so ecahi) egit ojoc adinumus ovihutivo</row>
        <row id="IGibupagezOnofomir">Zezizis adij tut ukogeva sikegunak, ecuku bav minujeko oga vebef-usunid ehak dohinafa</row>
        <row id="ESupeTojicoh">Comahi elutafu d jovogac ofegi ozirepudub bih cacafef</row>
        <row id="ATemimujadaSerabuzo">D ozirepudub lihovanos ot minujeko oga ohuhu IcemipuDupamiv</row>
        <row id="UDofojiFinUjipadifi">Jecuzu bav tut olepimuco lone mubozi medu NetasEtulig ojejupo</row>
        <row id="RUcikaduMatabadAter">Fidarof %s ihetarar</row>
        <row id="IJumobalAsurutejoj">Fidarof Ozirepudub so GononapopoKejojo</row>
        <row id="UBeNepahuJetila">Oriluj ihetarar comahi ep jope oga gesano ivodud</row>
        <row id="OJuKifopaHetapad">SezemoPemobaz bav tut olepimuco</row>
