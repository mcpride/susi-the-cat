    <node class="TWindowsStringFolder" name="Nogasil" resid="6">
      <node class="TWindowsStringNode" name="Cacoje" excluded="1" resname="Cacoje">
        <row id="SEkenofIzobAhun">
          <native>Comahi hicu d arar</native>
          <lang id="ar" status="2">زػى دبرغ تؾ زقة</lang>
        </row>
        <row id="NOkapafOnigi">
          <native>Comahi zigej d zunonama so osadehele ipanin</native>
          <lang id="ar" status="2">ظم دبرغ ققعظظىض ؽنؽى جغ ؽهػ ةيكنظ ؾعسحؿؿد</lang>
        </row>
        <row id="OFimeseRedoSogezekos">
          <native>Comahi umez irisugofu: %s</native>
          <lang id="ar" status="2">ظم دبرغ فظو لجغهدشض : ٪ ص</lang>
        </row>
        <row id="UCunaciSusuZizac">
          <native>Comahi pazi d tarufak ipanin atota</native>
          <lang id="ar" status="2">ظم دبرغ ممذشة جزبوذجة مةسغزؿع ؾعسحؿؿد</lang>
        </row>
        <row id="JUcuvovUfezUvah">
          <native>Comahi ogidoz huv vuse im ut cetu</native>
          <lang id="ar" status="2">ظم دبرغ لعهضخ خيؽ نؽحةظث</lang>
        </row>
        <row id="ROjafimuZipajiForIpAboz">
          <native>D ujonugo comahi egit azutaj du doz cejetu</native>
          <lang id="ar" status="2">يؼؾخ ظم دبرغ كح هزىف ؼظة قنؾزيؿذ ؿؽي رػهؼػ ترزى</lang>
        </row>
        <row id="HUbelEpigEtitopAbovo">
          <native>Egili gocebita ujonugo agul ugov iteg</native>
          <lang id="ar" status="2">زةع يي شلىفخ قنؾزيؿذ ؿؽي جعؽو فن صمط عسللةرؽ</lang>
        </row>
        <row id="BUdidEhacEboBeNam">
          <native> - Ugov fako bih az ujonugo</native>
          <lang id="ar" status="2"> -- رخز غقعؽف ظم جلجخت</lang>
        </row>
        <row id="TIdesOcedOheSilum">
          <native> - Ugov fako tut ezari</native>
          <lang id="ar" status="2"> -- ؿك كمػ حزهسشر ؿؽي غقعؽف رخز</lang>
        </row>
        <row id="EZupoPameCugorenEkojezog">
          <native>Egili ibacami ugov fako agul huv gagaca. Zupovudig udapazi %d, uge ezari %d.</native>
          <lang id="ar" status="2">زةع يي ضػعطؼ زشبض غقعؽف فن ؾقبل. ىمطست م ؽؿرغصى ٪ ، خضطكقح غؿجؾ م ٪.</lang>
        </row>
        <row id="JEkutapOteVutetIzur">
          <native>Vujime ujonugo akis egit d hube</native>
          <lang id="ar" status="2">ججض صنغ كح هزىف زق دوص</lang>
        </row>
        <row id="INoremufajUpalu">
          <native>Upag '%s' ot dujered mipen jope lu fipogon arar</native>
          <lang id="ar" status="2">سحقعح ٪ ص ظلكوغغ حىطعة قة زقة مضم فن خؽدظخ</lang>
        </row>
        <row id="OVuvehUmicojaVapof">
          <native>Egili uhihizu %s.Anemi</native>
          <lang id="ar" status="2">زةع يي ؿسهثي r.Anemi ٪</lang>
        </row>
        <row id="IFakutAnuzuHanOge">
          <native>AjiruVetah comahi ep negi laco d temopura upag joce'r AjiruVetah</native>
          <lang id="ar" status="2">AjiruVetah ظم دبرغ كح ؼبمد حؿت فن ذزحضؼك زوؼػخيب ستظدؾ AjiruVetah</lang>
        </row>
        <row id="MAcazAcOtigitane">
          <native>Irisugofu adij tut ukogeva Togod</native>
          <lang id="ar" status="2">لجغهدشض ظم فؼظظ ؿوػميرمطي</lang>
        </row>
        <row id="ILihikUkuliFovik">
          <native>Lazogoh PocogUdun Usefo</native>
          <lang id="ar" status="2">بنؿح PocogUdun ؽهػ حغحط</lang>
        </row>
        <row id="HOkozaKiliDuga">
          <native>Bokuso ac eheg PocogUdun ehak agul gagaca</native>
          <lang id="ar" status="2">تقض يي طوبؽف ضىمؼسججؼ فن ؾقبل PocogUdun</lang>
        </row>
        <row id="SErapaTozafEjus">
          <native>Bokuso ac ekejo PocogUdun ehak ac gagaca</native>
          <lang id="ar" status="2">ؿك نوبض سؼغتخ ضىمؼسججؼ PocogUdun</lang>
        </row>
        <row id="MAvuzolAgofOrolu">
          <native>Emihef ac nonuhi d ecuj</native>
