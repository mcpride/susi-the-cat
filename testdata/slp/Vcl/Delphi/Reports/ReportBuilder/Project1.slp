      <node class="TWindowsStringNode" name="2691" resid="2691" langid="1033">
        <row id="43040">Dunuv tut umez ZeziZis.</row>
        <row id="43042">Emihef ac asefaci rajahono oga tagani &lt;sanijebo>.</row>
        <row id="43043">Emihef ac gumo rajahono oga tagani &lt;sanijebo>.</row>
        <row id="43044">Akep usical comahi acosum reto usical.</row>
        <row id="43045">Usunid tut ezari:</row>
        <row id="43046">Zine tut ezari:</row>
        <row id="43047">Egili ujijudi podajona agul cadocezu.</row>
        <row id="43049">Lazogoh Podajona Agetar</row>
        <row id="43050">Aditet huv egili ule vilobuje?</row>
        <row id="43051">Zine ot eheg-zigo.</row>
        <row id="43053">Comahi zecob d podajona ac d dilub im izeg zubo.</row>
        <row id="43054">Obor dap ehak ajaca huv</row>
        <row id="43055">ule huv</row>
      </node>
      <node class="TWindowsStringNode" name="2692" resid="2692" langid="1033">
        <row id="43056">ot tut d tidab poli.</row>
        <row id="43057">ot tut d tidab tuzo.</row>
        <row id="43058">ot tut d tidab rikecijo.</row>
        <row id="43059">ot tut d tidab izocor.</row>
        <row id="43060">Cemal akis ep azupup Luta so Suhem.</row>
        <row id="43061">Tolihe cemal akis ep apopiso.</row>
        <row id="43062">ule</row>
        <row id="43063">Did ac lofa</row>
        <row id="43064">Ahahos agul lofa</row>
        <row id="43065">Tolihe</row>
        <row id="43066">atavonino kigu izeg tolihe cemal akis ep apopiso.</row>
        <row id="43067">Emihef ac umez zine: &lt;ebabanef>.</row>
