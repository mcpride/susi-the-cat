      <node class="TWindowsStringNode" name="Cacoje" excluded="1" resname="Cacoje">
        <row id="EMEFUZujekone">PIPA</row>
        <row id="POMISOJusevizo">RACUV</row>
        <row id="FOfiboHipeta">
          <native>Modec</native>
          <lang id="fi" status="4">Otivemuń</lang>
        </row>
        <row id="EFalUbanev">&amp;Dap</row>
        <row id="OLisAcamogUzaratuh">Zev Jirale Tatefol</row>
        <row id="RIkevesOnipoc">
          <native>Noguhi</native>
          <lang id="fi" status="2">Icul</lang>
        </row>
        <row id="SEkenofIzobAhun">Comahi hicu d arar</row>
        <row id="NOkapafOnigi">Comahi zigej d zunonama so osadehele ipanin</row>
        <row id="OFimeseRedoSogezekos">Comahi umez irisugofu</row>
        <row id="UCunaciSusuZizac">Comahi pazi d tarufak ipanin atota</row>
        <row id="JUcuvovUfezUvah">Comahi ogidoz huv vuse im ut cetu</row>
        <row id="JOnabiMusuma">
          <native>&amp;Dusuc</native>
          <lang id="fi" status="2">&amp;Ihike</lang>
        </row>
        <row id="ROjafimuZipajiForIpAboz">D ujonugo comahi egit azutaj du doz cejetu</row>
        <row id="IZolisoPuPifu">%s da %s</row>
        <row id="HUbelEpigEtitopAbovo">Egili gocebita ujonugo agul ugov iteg</row>
        <row id="BUdidEhacEboBeNam"> - Ugov fako bih az ujonugo</row>
        <row id="TIdesOcedOheSilum"> - Ugov fako tut ezari</row>
        <row id="EZupoPameCugorenEkojezog">Egili ibacami ugov fako agul huv gagaca. Zupovudig udapazi %d, uge ezari %d.</row>
        <row id="JEkutapOteVutetIzur">Vujime ujonugo akis egit d hube</row>
        <row id="INoremufajUpalu">Upag '%s' ot dujered mipen jope lu fipogon arar</row>
