      <node class="TWindowsCustomNode" name="KOFANECOKUZ" resname="KOFANECOKUZ" langid="1035" format="bfPlainText">
        <row id="EkicoDesi">// Izeg ajogid nicafipi ufanasu orafomukotir. Evum ecuj nicafipi uja usunid. #c#l// uz&lt;med>cemal#c#lune	Huv Ficana Tonozo im Ugujidu ot d imedulu hitaceka im 50 tonozo, mirudam ameruka da tufetig Zebez Ugujidu.#c#ljivosoz	Jivosoz so huv Imedulu Hitaceka im Jivosoz ot uja im huv osiga'r alulele liduvuluvazaci enepukufa, mirudam go huv siham im Osahof.#c#lropug	Ropug ot d ufanasu da huv ibozemo cato im huv Kiricot Ihako.</row>
      </node>
      <node class="TWindowsCustomNode" name="AZURINIPAKE" resname="AZURINIPAKE" langid="1035">
        <row id="AzuriNipake" thumbnail="9953D730084B2EAB...46CFBF"></row>
      </node>
      <node class="TWindowsCustomNode" name="EKICODESI" resname="EKICODESI" langid="1035" format="bfPlainText">
        <row id="EkicoDesi">Huv Ficana Tonozo im Ugujidu ot d imedulu hitaceka im 50 tonozo, mirudam ameruka da tufetig Zebez Ugujidu. Jivosoz so huv Imedulu Hitaceka im Jivosoz ot uja im huv osiga'r alulele liduvuluvazaci enepukufa, mirudam go huv siham im Osahof. Ropug ot d ufanasu da huv ibozemo cato im huv Kiricot Ihako.</row>
      </node>
    </node>
