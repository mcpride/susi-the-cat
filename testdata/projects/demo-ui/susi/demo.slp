      <row id="EGILI.COMAHI_EKARIZ_DAT_AC_JUVEGOGULU" state="0" created="20221121083558" note="{{ hube }} Ividumatezo iød Hube cagas Hofihafizigem">
        <native>[Comahi ekariz {{ hube }} dat ac huv juvegogulu ac johikijuv zubo, huv raduficam juvegogulu(r) osetig ep jenifum dolef]</native>
        <lang id="de" date="20241113151244">{{ hube }} ipi kib giduvosogu puvuk Vumirajusecib ropesžozu ovo omet bibim gelâovuk gidanu. Tutatacev Bem hegifoho Gufakżihopisu</lang>
        <lang id="en" date="20241113151247">{{ hube }} ot dajelege ac oz fuhop uja johikijuv zubo ule comahi ep jelunir. Ahahos huv raduficam ogidiveseje</lang>
        <lang id="it" date="20241113151251">{{ hube }} ś uzuhisuki un azifoc ih laku ol cijasodog u ise jeț hecida cezibuliv. Okinomeji ta ulojogar secetifijake</lang>
        <lang id="fr" date="20241113151255">{{ hube }} cik acï(u) è il pebem ih zubo je ininłavid gu fo rubo jak łezu aturoheń(u). Cogudovov beh vitoh ecuzajez</lang>
        <lang id="pt" date="20241113151302">{{ hube }} amuê nodobebafik d raga iviga bu laku je ekopabodocop u nźi sufa pal anenuåja. Onitek du pavilufuk mifojojorýîiv</lang>
        <lang id="es" date="20241113151306">{{ hube }} amuê efecemib ivif fûiter ivo ih laku je utinevacuketi h az reguj ivebenud. Odehogi jip uzakuginul canasag</lang>
        <lang id="ru" date="20241113151310">{{ hube }} фрыещы хя ьспмл у сюч у юуьгж дгбоу эпхыгжвзц н хя люеым бзрд бкюляж. Югвтвпб шшюэумофъ оайхею</lang>
        <lang id="fi" date="20241113151314">{{ hube }} da ogocugizef näukacțàu enajuj ikihafemajucuroram guvè malö ore isamuse. Izanep ogacavohe avalajiz</lang>
        <lang id="el" date="20241113151317">Β/Ψ {{ hube }} ηθυκυ χτκξηωπνχψξξ/ψ υω νπμξμτγηδψπ γτυψ πεξχ ιφβοκνχζδτψ βρλ πηκ πθλτθκ ξφ ξητξωγμγα. Πνυλφβεκυ σοδ ζχυενγψρ δνλεχχρδε</lang>
        <lang id="ko" date="20241113151325">{{ hube }} 퉎뒷쯋쓸 팎팁 뢒븇딵 쫈쿧 넮끠좐 휔쮸퇜쇗 밶셍 똑빼뛘 늬윢웎 뗂 븶쿹뽓뽫. 셓뾉 좌퍤뮶 돠핿잴태썣켢</lang>
        <lang id="sv" date="20241113151333">{{ hube }} ûm jojumev lapo ikati cu gukemirimob abo pib zuvu jesisod. Or ubal fûadocak risafidufo</lang>
        <lang id="vi" date="20241113151339">{{ hube }} ăáțv viźb pûu láe ža laéj cša okżu ekø cuvńo sż ruými reù uàt ăáțv. Api lżis uàt cși viźb pûu zan</lang>
        <lang id="pl" date="20241113151329">{{ hube }} zuja atadüatug e in iciduzeg gehari sedih ekipudela x dug heôra uj necošż. Egoú ahefșuheàpi avuøte</lang>
        <lang id="da" date="20241113151346">{{ hube }} eh acudijisur avihup ço emimahakufeji ov pib ogoj jenuzof. Esavi aäbatoto jupajivakitab</lang>
        <lang id="nb" date="20241113151348">{{ hube }} eh ohajih bot ikati ço rubacicudepad ov pib ogoj jenuzof. Esavi aäbatoto bemofuzohumo</lang>
        <lang id="ro" date="20241113151352">{{ hube }} huvu gucegov mi eler zan dek jicib copova je huvezisov éa ve cusul me ýanif. Óotuvoüh emuëlecacal ekivoneh</lang>
      </row>
      <row id="EGILI.SAGUG_ARAR_SULAGI" state="0" created="20200506135053">
