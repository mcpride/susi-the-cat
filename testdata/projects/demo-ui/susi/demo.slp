      <row id="EGILI.LAZOGOH" state="0" created="20200506135053" note="Das &quot;Hube&quot; efuhugif#c#l">
        <native>[{{ ifipahuki }} ot tut tidab]</native>
        <lang id="de" date="20200506135749">{{ ifipahuki }} ipi bibim hăulag</lang>
        <lang id="en" date="20200608161051">{{ ifipahuki }} ot lazogoh</lang>
        <lang id="it" date="20200608161930">{{ ifipahuki }} ise ś pahaju</lang>
        <lang id="fr" date="20200608161335">{{ ifipahuki }} cik rapigavi</lang>
        <lang id="pt" date="20200608161651">{{ ifipahuki }} nźi ú rđakip</lang>
        <lang id="es" date="20200608161243">{{ ifipahuki }} az ip rđakip</lang>
        <lang id="ru" date="20200608161744">{{ ifipahuki }} ядгюкроаэиеяычэ</lang>
        <lang id="fi" date="20210317142921">{{ ifipahuki }} ro lohoje</lang>
        <lang id="el" date="20210720103252">Σρ {{ ifipahuki }} πηκ ηθυκυ πξγηυρ</lang>
        <lang id="ko" date="20210719161712">{{ ifipahuki }} 퀬졇햟 릥빚툔줆 썯헇</lang>
        <lang id="sv" date="20210719161540">{{ ifipahuki }} ûm zuvu alirotu</lang>
        <lang id="vi" date="20210720103320">{{ ifipahuki }} ruými oèk zź</lang>
        <lang id="pl" date="20210719161638">{{ ifipahuki }} dug zuja arecirèoga</lang>
        <lang id="da" date="20221215103302">{{ ifipahuki }} eh ogoj temojom</lang>
        <lang id="nb" date="20221215103403">{{ ifipahuki }} eh ogoj bamegi</lang>
        <lang id="ro" date="20221215103532">{{ ifipahuki }} ve huvu ororubi</lang>
      </row>
      <row id="EGILI.LAZOGOH_ZINE_EVEKOHE" state="0" created="20230215143506">
        <native>[Lazogoh zine evekohe]</native>
        <lang id="de" date="20230215150725">Hibevidas Zirenicamef</lang>
        <lang id="en" date="20230316143503">Lazogoh zine evekohe</lang>
        <lang id="it" date="20230316143811">Upehovopa zine ise pahaju</lang>
        <lang id="fr" date="20230316143646">Olugovi je erigibo rapigavi</lang>
        <lang id="pt" date="20230316144107">Ujebiüfu eg lakinor befáorab</lang>
        <lang id="es" date="20230316144304">Imetosida je ecesota az rđakip</lang>
        <lang id="ru" date="20230316144229">Яуйеатнш ыьшзгрдощс жубтж</lang>
        <lang id="fi" date="20230316143551">Oresicipahe ukikujohu lazóefè</lang>
        <lang id="el" date="20230316143736">Βρ πξγηυρ ηπλγηφβχγβξ θψδψρηπ</lang>
        <lang id="ko" date="20230316143844">쑜릥촠 뢗츴 뙴눗</lang>
        <lang id="sv" date="20230316144356">Kuledico otavinafźit</lang>
        <lang id="vi" date="20230316144455">Aój nusi káo ruými oèk zź</lang>
        <lang id="pl" date="20230316144031">Etitufedoödih umutonióû aputu</lang>
        <lang id="da" date="20230316143348">Luzakaji otorakoric</lang>
        <lang id="nb" date="20230316143932">Gujoluk ohezotupil</lang>
        <lang id="ro" date="20230316144140">Samćacij geókin ebihupu</lang>
      </row>
      <row id="EGILI.LAZOGOH_ZINE_ZUBO" state="0" created="20221121083558">
        <native>[Lazogoh zine zubo, zigo {{ rogiPiza }} zine(r) bav hijamav]</native>
        <lang id="de" date="20221121113056">Lajźomovu Nizimagacora: {{ rogiPiza }}</lang>
        <lang id="en" date="20221215103626">Hijamav zine ofafisu: {{ rogiPiza }}</lang>
        <lang id="it" date="20221215104007">Fisatat zine apovipafol: {{ rogiPiza }}</lang>
        <lang id="fr" date="20221215103839">Ofafisu je erigibo epahipeïm&#160;: {{ rogiPiza }}</lang>
        <lang id="pt" date="20221215104201">Kavogaco je lakinor vekopozivo: {{ rogiPiza }}</lang>
        <lang id="es" date="20221215104321">Kavogaco je ecesota ahapidulu: {{ rogiPiza }}</lang>
        <lang id="ru" date="20221215104235">Ьцдфгбмтрм тщъбйюк щждхшя: {{ rogiPiza }}</lang>
        <lang id="fi" date="20221215103752">Ezosasag izavutomahukot: {{ rogiPiza }}</lang>
        <lang id="el" date="20221215103927">Χπβμοδηδχθγτυ υοπνβρ ιζωζσλχ: {{ rogiPiza }}</lang>
        <lang id="ko" date="20221215104041">쓮컽 뢗츴 뵮튑: {{ rogiPiza }}</lang>
        <lang id="sv" date="20221215104408">Ligaåvuz ovokomefi: {{ rogiPiza }}</lang>
        <lang id="vi" date="20221215104453">Üóce søuh káo luj uróu: {{ rogiPiza }}</lang>
        <lang id="pl" date="20221215104112">Alotozope tobemef italço: {{ rogiPiza }}</lang>
        <lang id="da" date="20221215103302">Ihakomit pejagarogad: {{ rogiPiza }}</lang>
        <lang id="nb" date="20221215103403">Uzugutet pejagarogad: {{ rogiPiza }}</lang>
        <lang id="ro" date="20221215103532">Duketec je ukțisec lejinonuj: {{ rogiPiza }}</lang>
      </row>
      <row id="EGILI.LAZOGOH_GAPIZ_VUSE" state="0" created="20221121083558">
        <native>[Lazogoh gapiz vuse, huv gasetid hijamav vuse (duzel {{duzel}}am, usical {{usical}}am)]</native>
        <lang id="de" date="20221121113507">Oso ogopacob Bihojopuåtuke odi {{duzel}} g {{usical}} ipi ćunudupihuzil</lang>
        <lang id="en" date="20221215103626">Cazifoci gasetid gapiz ocejisemag im {{duzel}} g {{usical}}</lang>
        <lang id="it" date="20221215104007">Ś maraf uguvorez fe ohatepezigi ituneve ol {{duzel}} g {{usical}} sov f'asihiveh</lang>
        <lang id="fr" date="20221215103839">Fe ećgepuvopo ogopacob je f'gapiz je {{duzel}} g {{usical}} cik imoñvöe</lang>
        <lang id="pt" date="20221215104201">Dog urusezelojuj d fivuzišțj je jezope uébebo je {{duzel}} g {{usical}}</lang>
        <lang id="es" date="20221215104321">Sa pi itilaloj fe duvirakaôp je adojod uébebo je {{duzel}} g {{usical}}</lang>
        <lang id="ru" date="20221215104235">Мтпдпздхъюлл кйэхьеиьвт яоымышпхный {{duzel}} g {{usical}} ешэрсвэхи</lang>
        <lang id="fi" date="20221215103752">Gegitúadoceredep {{duzel}} g {{usical}} gikodiveke</lang>
        <lang id="el" date="20221215103927">Ρθθζωωοη τχθ θναλτνβθ ημφυευπχ ηλνμειξ {{duzel}} g {{usical}}</lang>
        <lang id="ko" date="20221215104041">{{duzel}} g {{usical}}쪉 칟롒 셿갻둶 퍾쨩쵹귒 긏솙뱶</lang>
        <lang id="sv" date="20221215104408">Ifu ufogonav enifahihûimofoje {{duzel}} g {{usical}} ada ôopoluloluji</lang>
        <lang id="vi" date="20221215104453">Šš ožáf opł ýú zeôz kaåv vçun łpe uțn üg {{duzel}} g {{usical}}</lang>
        <lang id="pl" date="20221215104112">Gesumelifuji dobatebojš olilucilasuýż urobat {{duzel}} g {{usical}}</lang>
        <lang id="da" date="20221215103302">Ifu dolobosad ehekivogożleceb eü {{duzel}} g {{usical}} eh kenubaletum</lang>
        <lang id="nb" date="20221215103403">Upikalal sudebakoráimomu eü {{duzel}} g {{usical}} eh kenubaletum</lang>
        <lang id="ro" date="20221215103532">Ecupucåip kiduhš je {{duzel}} g {{usical}} huvu zivńđalê</lang>
      </row>
      <row id="EGILI.HIN" state="0" created="20221212094522" note="Ibubub cagas Genarejegi, Ovacabo go Ujiloj">
