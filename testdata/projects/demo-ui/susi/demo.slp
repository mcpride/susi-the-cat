      <row id="ARAGON_ARAR.APORIB_SO_EMOC_NUKI" state="0" created="20221121083558">
        <native>[Aporib so emoc husud unaz]</native>
        <lang id="de" date="20230220145815">Ezebefo dibeënuvo ojoj loba anotega</lang>
        <lang id="en" date="20230316143514">Aporib husud so zecob husud unaz</lang>
        <lang id="it" date="20230316143816">Azapoburuhu x zine i loviticadig ale</lang>
        <lang id="fr" date="20230316143646">Aôgeniruvafi beh iniguted ob beh nóitito iha</lang>
        <lang id="pt" date="20230316144107">Ekaholalob naloboku ob asepuü-jip ukec</lang>
        <lang id="es" date="20230316144304">Bimivudelep mepivanu i morojagisi ticń</lang>
        <lang id="ru" date="20230316144229">Nезнччзни яюъйк фшп еншщгсе цщлсз</lang>
        <lang id="fi" date="20230316143551">Ucekamo sikisicil oru upajam iñbâa</lang>
        <lang id="el" date="20230316143738">Πορθηνδ θψδψρηπ ξ φγτθλυψγφο ξηζ</lang>
        <lang id="ko" date="20221215104041">뢗츴 끯쩕 멌볝 횠좥뀩 힊뭺</lang>
        <lang id="sv" date="20230316144356">Aèfu zonaz petev anudenof guj ažb</lang>
        <lang id="vi" date="20230316144455">Måu roéf raäm aøv igț káo ń çég</lang>
        <lang id="pl" date="20221215104112">Ajopamu ovac nar ohoåle amope</lang>
        <lang id="da" date="20230316143354">Uçnu zonaz, petev tin sik</lang>
        <lang id="nb" date="20221215103403">Umad lel petev ikico sik</lang>
        <lang id="ro" date="20230316144140">Onocošfi ukțisec zan ofitefo sipe</lang>
      </row>
      <row id="ARAGON_ARAR.NOGUHI_ARAGON_HODEGOV" state="0" created="20221121083558">
        <native>[Upek ijajesaf husud bav tut zadomuje uru, bav git ihad fuku ac noguhi aragon ificuvu ?]</native>
        <lang id="de" date="20221121123208">Vem Aragon huse nadikevehab. Toko Bem apehak?</lang>
        <lang id="en" date="20221215103646">Aragon izaj ep hapisaba. Bav git ihad?</lang>
        <lang id="it" date="20221215104007">Fa ukecujinumu ś nolup ajosibediz. Efifejalog?</lang>
        <lang id="fr" date="20250103131833">Ta ațgâilefikijoj iz łezu defeguteje. Gogojujal-uhar hojukupifi&#160;?</lang>
        <lang id="pt" date="20221215104201">I ihorirofucer ugaý tedurakab. Ozaä ota itirafo?</lang>
        <lang id="es" date="20221215104321">Sa dajubekeń fe elojo. ¿Amuê imejih?</lang>
        <lang id="ru" date="20221215104235">Ынетавдц эблцч яежчмтншэй. См ндсэзюъ?</lang>
        <lang id="fi" date="20221215103752">Ricesu amazobibońâs. Lejari hovoz?</lang>
        <lang id="el" date="20221215103927">Ψ ρμμσθκρζινι νξκαμρθηλρδ. Ζαετμε ξφ μμκβλγηεδω;</lang>
        <lang id="ko" date="20221215104041">쨴쒽쳺원 팏뼐킲퓦걼. 햂먼칳쒧쥙?</lang>
        <lang id="sv" date="20221215104408">Ofuresedecifi ucofebo. Ûm ik fèura?</lang>
        <lang id="vi" date="20221215104453">Opł tuùku dùi múu sï töa lń. Aôs uâ ikáe seär ruými?</lang>
        <lang id="pl" date="20221215104112">Ninijuçluze icacepe azabuheze. Tom ku lekap labenu itajakutucî?</lang>
        <lang id="da" date="20221215103302">Ijedupalarapiso akoracep. Efi ik vicafîuji?</lang>
        <lang id="nb" date="20221215103403">Igevokeluban vemobeli. Eh ik ananes?</lang>
        <lang id="ro" date="20221215103532">Óidóaveceg huvu úzeciroraë. Ivafaåz ivemo(ä)?</lang>
      </row>
