        <lang id="ro" date="20221215103532">Ogihabula anehenam éa d vimipezocabu</lang>
      </row>
      <row id="ARAR.EKIS_KICEVAPE_JESIFIT" state="0" created="20221121083558">
        <native>[Juvegogulu im ekis - ekis ujap]</native>
        <lang id="de" comment="Ozacđerufipafo" date="20250108144228">Ehoraúzarov odi Kapumev ovo Ekis-Zokob</lang>
        <lang id="en" date="20250108144233">Juvegogulu im ekis ule ekis ujap</lang>
        <lang id="it" date="20221215104007">Kapikeredide ol hesocabł u deser</lang>
        <lang id="fr" date="20221215103843">Ruba zuken ułbof gu uýji</lang>
        <lang id="pt" date="20221215104201">Mimodavurëža je udiled u abiäür</lang>
