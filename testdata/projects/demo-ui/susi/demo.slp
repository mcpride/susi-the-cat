      <row id="EGILI.ASALIPASI" state="0" created="20200506135053">
        <native>[D gasetid im {{ ivofad }} avisaharog bav hijamav]</native>
        <lang id="de" date="20200506171014">Boviber {{ ivofad }} Ubobohe morșohav</lang>
        <lang id="en" date="20200608161051">D gasetid im {{ ivofad }} avisaharog bav hijamav</lang>
        <lang id="it" date="20200608161930">Ś ekubihemef ih icuhedo ol {{ ivofad }} sibefohek</lang>
        <lang id="fr" date="20200608161335">{{ ivofad }} kedadu gasetid epahipeïm</lang>
        <lang id="pt" date="20200608161651">Pùigod je {{ ivofad }} ezipibidic vekopozivo</lang>
        <lang id="es" date="20200608161243">Sa azavemo ih pùigod je {{ ivofad }} ezipibidic</lang>
        <lang id="ru" date="20200608161744">Шмэчбосфе хьбыхсзезуу {{ ivofad }} лчвл(п; як)</lang>
        <lang id="fi" date="20210317142921">Ezopeget ekebiäâf {{ ivofad }} vepariö</lang>
        <lang id="el" date="20210720103252">Β ιλνρλψακ ξξκθξοκδχνκαχ μοπσσβμ λρωολρερεζ ηθυκυ {{ ivofad }}</lang>
        <lang id="ko" date="20210719161712">칟롒 {{ ivofad }}인 씴쫒퇃 꾄퉕쑡</lang>
        <lang id="sv" date="20210719161540">Ukulezuv {{ ivofad }} bunuko biseúsa</lang>
        <lang id="vi" date="20210720103320">Luj uróu uțn üg {{ ivofad }} vü fș</lang>
        <lang id="pl" date="20210719161638">Ipisufogo vonuri zuvaśb – pofu. {{ ivofad }}</lang>
        <lang id="da" date="20221215103302">Ivakuviha {{ ivofad }} mogu fazejop</lang>
        <lang id="nb" date="20221215103403">Apemiben {{ ivofad }} mogu ofogina</lang>
        <lang id="ro" date="20221215103532">Huvu rusamoli jorekariki togig {{ ivofad }}</lang>
      </row>
      <row id="EGILI.HIN_ZINE_VUSE_ESUNAVUT" state="0" created="20221121083558">
        <native>[D gasetid zine vuse cazifoci, huv gasetid hijamav vuse ot {{ vuse }}of]</native>
        <lang id="de" date="20221121112936">Oso ogopacob Bilidipïåa odi {{ vuse }}OF ipi ćunudupihuzil</lang>
        <lang id="en" date="20221215103626">Cazifoci gasetid zine vuse im {{ vuse }}OF</lang>
        <lang id="it" date="20221215104007">Ibig ralel ucetoner ta hakovesake silumis ol {{ vuse }}&#160;OF sov fa zine</lang>
        <lang id="fr" date="20221215103839">Fe onover ogopacob je erigibo je {{ vuse }}&#160;Su cik imoñvöe</lang>
        <lang id="pt" date="20221215104201">Dog sabijesejaje i ujumaze je lakinor pùigod je {{ vuse }} OF</lang>
        <lang id="es" date="20221215104321">Sa pi itilaloj tu abafłu je ecesota pùigod je {{ vuse }}OF</lang>
        <lang id="ru" date="20221215104235">Йчаофбтщаахщ ыэпэфг жубтж {{ vuse }}ЬЧ юыйдкщсг</lang>
        <lang id="fi" date="20221215103752">Ukikujohu gonidçenupas {{ vuse }}&#160;Uv gikodiveke</lang>
        <lang id="el" date="20221215103927">Ρθθζωωοη ηψω ωθθγζππω τβυαλσγτ θψδψρηπ {{ vuse }}OF</lang>
        <lang id="ko" date="20221215104041">{{ vuse }}EN높 칟롒 뢗츴 켃똼툑 긏솙뱶</lang>
        <lang id="sv" date="20221215104408">Ifu ufogonav zefegabafuma {{ vuse }} OF ada ôopoluloluji</lang>
        <lang id="vi" date="20221215104453">Šš ožáf opł ołcu foèñn káo uțn üg {{ vuse }} OF</lang>
        <lang id="pl" date="20221215104112">Gesumelifuji devobeluso verohus aputu {{ vuse }}&#160;OF</lang>
        <lang id="da" date="20221215103302">Ifu dolobosad epetoåtulide eü {{ vuse }}OF eh kenubaletum</lang>
        <lang id="nb" date="20221215103403">Upikalal epetoåtulide eü {{ vuse }}OF eh kenubaletum</lang>
        <lang id="ro" date="20221215103532">Sijezajeju kiduhš d ubșiroruho je {{ vuse }}OF huvu zivńđalê</lang>
      </row>
