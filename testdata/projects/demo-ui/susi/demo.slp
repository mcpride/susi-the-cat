      <row id="EGILI.ORUKIHUG_LAHUDIMI_ANOPU" state="0" created="20240614134227">
        <native>[Orukihug lahudimi akis ep ehabe so ilavib laco huv obe im agojinad ule sucifamokul apujivumu (gubojom {{elaboDeheralaPejujazo}})]</native>
        <lang id="de" date="20240709153934">Gubojom iød ifu Fovudepujud-Ozegijemanifa: Repun odi Rejevonenesudi ovo Ogohofutebananuko (={{elaboDeheralaPejujazo}} Ovacabo)</lang>
        <lang id="en" date="20240806093806">Gubojom oga huv orukihug tuzo ojonoliji cemal: obe im agojinad tuzo ule sucifamokul tuzo (={{elaboDeheralaPejujazo}} jefofud)</lang>
        <lang id="it" date="20240806094356">Omegum aponac akodaf sov fa isuvu ol avevucitajic: isuvu ol otibudomurakoki + isuvu ol tilepofiseze (={{elaboDeheralaPejujazo}} vufohi)</lang>
        <lang id="fr" date="20240806094155">Gubojom erip fe anenar jamol je aluki je sikakulica&#160;: mavuj je fe odeün je epogahuzi gu je fe odeün je goâlelukobi (={{elaboDeheralaPejujazo}} jefofud)</lang>
        <lang id="pt" date="20240806094643">Fûiter ivap i ahomu kuveji je isuvu je orima: imud eg isuvu je latopah u eg isuvu je redevadåžo (={{elaboDeheralaPejujazo}} Ovacabo)</lang>
        <lang id="es" date="20240806094857">Ahomu abozef fûiter oku lefocu je oliguh: roje oku lefocu je evifives h oku lefocu je ezizufipuôt (={{elaboDeheralaPejujazo}} uhunegu)</lang>
        <lang id="ru" date="20240806094737">Эмсубфэвятя азюмэъсхг джиыъмпэ ымажсэц жюыйадгюшы ыгахп оыачюинмня: ъэцзг ымажсэц ксюецл н ымажсэц жюыйадгюшы (={{elaboDeheralaPejujazo}} рчкйб)</lang>
        <lang id="fi" date="20240806094102">Amebufegib eödetećsibara: uzahovecocova ed gororobofonatu petem (={{elaboDeheralaPejujazo}} pirerofos)</lang>
        <lang id="el" date="20240806094245">Κψεγσιμμ ξιδρθφ ρψφν χββχυλβ ηδσντρ: απρικνεν ηδσντρ τθλσχψξνχψ βρλ ηδσντρ βζνυορεωζυωλρ (={{elaboDeheralaPejujazo}} βοξθα)</lang>
        <lang id="ko" date="20240808080900">틀옕 킴쐞 쫙뢶뺎뇓 팪긹슦: 쫕샢 킴쐞 닳 쭹쏑 닢헚뷅 쎾쀃(={{elaboDeheralaPejujazo}}핀)</lang>
        <lang id="sv" date="20240806094955">Gubojom oóz ocazivijucoézaviméogec: Juvucu do niguöficepomo abo gźotemucituhizu (={{elaboDeheralaPejujazo}} mulozaz)</lang>
        <lang id="vi" date="20240806095045">Ruż jiô usśżat ezüu uhug deru uênu că gñic uțn oviśc: Ońgo ezüu uhug eźt gšuz sż ezüu uhug gikûe sï (={{elaboDeheralaPejujazo}} niân)</lang>
        <lang id="pl" date="20240806094547">Acafegufu ojahaåł ube cagirçes jakalado jovam itivil: roje jovam zirukasefar x jovam rucijerebagok (={{elaboDeheralaPejujazo}} fom)</lang>
        <lang id="da" date="20240806093959">Gubojom oga iûdoradaăcacah oga unujuramo: hufevo ha enohțehusadeb ov mucekozirivurogo (={{elaboDeheralaPejujazo}} okeduvol)</lang>
        <lang id="nb" date="20240806094452">Gubojom oga sarimepimiziki oga uhopivapu: Hufevo do ponojñuhurigep ov ometojïigutomal (={{elaboDeheralaPejujazo}} okeduvol)</lang>
        <lang id="ro" date="20240808081104">Hefig ejusop lerocu eseverimej d huriziji je limovucep: Roje huriziji je efuïûfub éa d huriziji je ijunśareb (={{elaboDeheralaPejujazo}} ekituh)</lang>
      </row>
      <row id="EGILI.ORUKIHUG_LAHUDIMI_ANOPU_HOCOVAM_AGOJINAD" state="0" created="20240912111509">
        <native>[Orukihug lahudimi akis ep ehabe so ilavib laco sucifamokul lahudimi (gubojom {{elaboDeheralaPejujazo}})]</native>
        <lang id="de" comment="orehak" date="20241011120113">Gubojom iød ifu Fovudepujud-Ozegijemanifa: Ogohofutebananuko (={{elaboDeheralaPejujazo}} Ovacabo)</lang>
        <lang id="en" date="20250114092748">Gubojom oga huv orukihug tuzo ojonoliji: Sucifamokul tuzo (={{elaboDeheralaPejujazo}} jefofud)</lang>
        <lang id="it" date="20250114093009">Akodaf sov fa omegum aponac oku isuvu ol avevucitajic: isuvu ol otibudomurakoki (={{elaboDeheralaPejujazo}} vufohi)</lang>
        <lang id="fr" date="20250114092917">Gubojom erip fe anenar jamol je aluki je sikakulica°: odeün je goâlelukobi (={{elaboDeheralaPejujazo}} jefofud)</lang>
        <lang id="pt" date="20250114093206">Fûiter ivap i ahomu kuveji je isuvu je orima: isuvu je redevadåžo (={{elaboDeheralaPejujazo}} uhunegu)</lang>
        <lang id="es" date="20250114093406">Ahomu abozef fûiter oku lefocu je oliguh: lefocu je ezizufipuôt (={{elaboDeheralaPejujazo}} uhunegu)</lang>
        <lang id="ru" date="20250114093338">Эмсубфэвятя азюмэъсхг джиыъмпэ ымажсэц жюыйадгюшы ыгахп оыачюинмня: цххъу жюыйадгюшы (={{elaboDeheralaPejujazo}} рчкйб)</lang>
        <lang id="fi" date="20250114092851">Amebufegib eödetećsibara: Osavudarisuzer (={{elaboDeheralaPejujazo}} pirerofos)</lang>
        <lang id="el" date="20250114092945">Κψεγσιμμ ξιδρθφ ρψφν ηδσντρ χββχυλβ: χθψκδι βζνυορεωζυωλρ (={{elaboDeheralaPejujazo}} βοξθα)</lang>
        <lang id="ko" date="20250114093041">틀옕 킴쐞 괾뎨귍뉷 팪긹슦: 쭹쏑 킴쐞(={{elaboDeheralaPejujazo}}핀)</lang>
        <lang id="sv" date="20250114093713">Gubojom oóz ocazivijucoézaviméogec: Gźotemucituhizu (={{elaboDeheralaPejujazo}} mulozaz)</lang>
        <lang id="vi" date="20250114093442">Ruż jiô uțn oviśc usśżat ezüu uhug deru uênu că gñic: Ezüu uhug gikûe sï (={{elaboDeheralaPejujazo}} niân)</lang>
        <lang id="pl" date="20250114093140">Acafegufu ojahaåł ube cagirçes jakalado jovam itivil: abeb rucijerebagok (={{elaboDeheralaPejujazo}} fom)</lang>
        <lang id="da" date="20250114091248">Gubojom oga iûdoradaăcacah oga ekizibukivoj: mucekozirivurogo (={{elaboDeheralaPejujazo}} okeduvol)</lang>
        <lang id="nb" date="20250114093110">Gubojom oga sarimepimiziki oga uhopivapu: ometojïigutomal (={{elaboDeheralaPejujazo}} okeduvol)</lang>
        <lang id="ro" date="20250114093303">Hefig ejusop lerocu eseverimej de huriziji je limovucep: Comu je ijunśareb (={{elaboDeheralaPejujazo}} ekituh)</lang>
      </row>
