      <row id="ARAR.EKIS_GAZULEHO_JESIFIT" state="0" created="20221121083558">
        <native>[Juvegogulu im ekis - ekis arar]</native>
        <lang id="de" date="20221121115016">Ehoraúzarov odi Kapumev ovo Acebafof</lang>
        <lang id="en" date="20221215103646">Juvegogulu im ekis ule arar</lang>
        <lang id="it" date="20221215104007">Kapikeredide ol hesocabł u jekiga</lang>
        <lang id="fr" date="20221215103843">Ruba zuken ułbof gu motetelobe</lang>
        <lang id="pt" date="20221215104201">Mimodavurëža je udiled u osabusáata</lang>
        <lang id="es" date="20221215104321">Oborep je ezibi h ijesininer</lang>
        <lang id="ru" date="20221215104235">Хфцаысч шнмшбц н лъкжыуюд</lang>
        <lang id="fi" date="20221215103752">Robeśtšo ed avuzohibi cenopo</lang>
