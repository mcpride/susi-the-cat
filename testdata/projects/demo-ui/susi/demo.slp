      <row id="ARAR.LOSUTO" state="0" created="20200506135053">
        <native>[Losuto]</native>
        <lang id="de" date="20200506153654">Azoăpe</lang>
        <lang id="en" date="20200608161051">Losuto</lang>
        <lang id="it" date="20200608161930">Dopalet</lang>
        <lang id="fr" date="20200608161335">Pojaciv</lang>
        <lang id="pt" date="20200608161651">Ejoájum</lang>
        <lang id="es" date="20200608161243">Dopalet</lang>
        <lang id="ru" date="20200608161744">Фечшь</lang>
        <lang id="fi" date="20210317142921">Oronavavi</lang>
        <lang id="el" date="20210720103252">Ιαθτγβ</lang>
        <lang id="ko" date="20210719161712">뱗붫숗</lang>
        <lang id="sv" date="20210719161540">Rocåa</lang>
