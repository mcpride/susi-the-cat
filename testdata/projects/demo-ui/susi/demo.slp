      <row id="EGILI.HASATONI" state="0" created="20200506135053" note="Das &quot;Hube&quot; efuhugif#c#l">
        <native>[Izeg ot TUT d tidab {{ ifipahuki }}; oveduj rejese uja agul lofa.]</native>
        <lang id="de" date="20200506171135">{{ ifipahuki }} ireśboha; uzepa aûfegu Bem apeja Civusoh</lang>
        <lang id="en" date="20200608161051">{{ ifipahuki }} lazogoh; oveduj rejese ut okovo</lang>
        <lang id="it" date="20200608161930">{{ ifipahuki }} ise pahaju; azapoburuhu muf osoc ujev'ohijim</lang>
        <lang id="fr" date="20200608161335">{{ ifipahuki }} rapigavi&#160;; adomabab aôgeniruvafi egi dapețk</lang>
        <lang id="pt" date="20200608161651">{{ ifipahuki }} befáorab; aka utosu fejehamig ado ucizado</lang>
        <lang id="es" date="20200608161243">{{ ifipahuki }} az rđakip; orerifazuj muf ucizado</lang>
        <lang id="ru" date="20200608161744">{{ ifipahuki }} ядгюкроаэиеяычэ; ъюъзьййл члнрцй</lang>
        <lang id="fi" date="20210317142921">{{ ifipahuki }} ro lohoje, ucekamo upekacuü</lang>
        <lang id="el" date="20210720103252">Σρ {{ ifipahuki }} πηκ ηθυκυ πξγηυρ, οσγτταιε χωτ ζαπβτγμκφχ</lang>
        <lang id="ko" date="20210719161712">{{ ifipahuki }} 퀬졇햟 릥빚툔줆 썯헇, 뫷뉐레 햷홭뼅틫쐨뿂.</lang>
        <lang id="sv" date="20210719161540">{{ ifipahuki }} kuledico; aèfu cu enah</lang>
        <lang id="vi" date="20210720103320">{{ ifipahuki }} ruými oèk zź; api lżis roéf cša fùo</lang>
        <lang id="pl" date="20210719161638">Etitufedoödih {{ ifipahuki }}, ajopamu bopi</lang>
        <lang id="da" date="20221215103302">{{ ifipahuki }} eh luzakaji; uçnu cu enah</lang>
        <lang id="nb" date="20221215103403">{{ ifipahuki }} gujoluk, umad cu tokoóvago</lang>
        <lang id="ro" date="20221215103532">{{ ifipahuki }} ve huvu ororubi, gá mevńa aź nakimisïi i izevoke</lang>
      </row>
      <row id="EGILI.TUT_HIJAMAV_AVISAHAROG" state="0" created="20240314104915">
        <native>['{{avisaharog}}' tut hijamav]</native>
        <lang id="de" date="20240315134212">Hegifoho Ubobohe toko bibim ugibesa: {{avisaharog}}</lang>
        <lang id="en" date="20240806093806">Huv raduficam avisaharog bav tut lepobezun: {{avisaharog}}</lang>
        <lang id="it" date="20240806094356">X ulojogar sibefohek ise ibig apovipafol: {{avisaharog}}</lang>
        <lang id="fr" date="20240806094155">Beh ufihohćare ecuzajez fo ofoc jak epahipeïm&#160;: {{avisaharog}}</lang>
        <lang id="pt" date="20240806094643">Al ezipibidic pavilufuk nźi añp vekopozivo: {{avisaharog}}</lang>
        <lang id="es" date="20240806094857">Jip uzakuginul ezipibidic az utałh vekopozivo: {{avisaharog}}</lang>
        <lang id="ru" date="20240806094737">Росмллныпгтящ экеънжнгы зояням ьъдгщкдсзбб: {{avisaharog}}</lang>
        <lang id="fi" date="20240806094102">Ogacavohe mihofu alećg rec ocudigepip: {{avisaharog}}</lang>
        <lang id="el" date="20240806094245">Πηκ υψγηγψυρυρηο γε ιδατλεθμδ μοζοψψιμτα: {{avisaharog}}</lang>
        <lang id="ko" date="20240808080900">잰횄꺍 뫆돇 솝뽱굟 넥콸닛씄 썯헇: {{avisaharog}}</lang>
        <lang id="sv" date="20240806094955">Fûadocak bunuko biseúsa zuvu: {{avisaharog}}</lang>
        <lang id="vi" date="20240806095045">Ruými ăáțv uróu tłic cși vü fș zan: {{avisaharog}}</lang>
        <lang id="pl" date="20240806094547">Ahefșuheàpi tulup dug iï alotozope: {{avisaharog}}</lang>
        <lang id="da" date="20240806093959">Aäbatoto mogu eh ogoj fazejop: {{avisaharog}}</lang>
        <lang id="nb" date="20240806094452">Aäbatoto mogu eh ogoj ofogina: {{avisaharog}}</lang>
        <lang id="ro" date="20240808081104">Emuëlecacal guluhepoz ve hico apafige: {{avisaharog}}</lang>
      </row>
      <row id="EGILI.TUT_HIJAMAV_IFOVUPIRODU" state="0" created="20240314104915">
        <native>[Ifovupirodu tut hijamav]</native>
        <lang id="de" date="20240314105252">Borufiso Edunerafemi toko bibim ugibesa</lang>
        <lang id="en" date="20240806093806">Ocuhad inimac bav tut lepobezun</lang>
        <lang id="it" date="20240806094356">X gehag gatav ise ibig apovipafol</lang>
        <lang id="fr" date="20240806094155">Beh egehifo usipazo fo ofoc jak epahipeïm</lang>
        <lang id="pt" date="20240806094643">Luziăde venope nźi añp vekopozivo</lang>
        <lang id="es" date="20240806094857">Icufu ivelize az oleferega</lang>
        <lang id="ru" date="20240806094737">Метшмфс ыгыэзшр жомкбмжаюсу</lang>
        <lang id="fi" date="20240806094102">Gu ore eratalagim sodur dâujibùuteô lodïofèac</lang>
        <lang id="el" date="20240806094245">Πηκ φωεροπχψωχλ σρ ξψβιυ αεξχ τανμψζμβ</lang>
        <lang id="ko" date="20240808080900">뛑팇 쎺럊 쓮컽 쎊 픫</lang>
        <lang id="sv" date="20240806094955">Umulev omisikeguj ûm zuvu ligaåvuz</lang>
        <lang id="vi" date="20240806095045">Ruými ăáțv uâ veb jafüud ulúin</lang>
        <lang id="pl" date="20240806094547">Edonûiso ohalor dug iï alotozope</lang>
        <lang id="da" date="20240806093959">Ibuteja hijamihov eh ogoj fazejop</lang>
        <lang id="nb" date="20240806094452">Icufu asagizihi eh ogoj ofogina</lang>
        <lang id="ro" date="20240808081104">Ikiïkela faded ve hico apafige</lang>
      </row>
      <row id="EGILI.TUT_BOJUTA" state="0" created="20200506135053" note="Das &quot;Hube&quot; efuhugif#c#l">
