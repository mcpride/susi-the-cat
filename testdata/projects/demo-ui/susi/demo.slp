        <lang id="de" date="20221130090146">Uzepa ecusun otap Lovotigosenih aûfegu</lang>
        <lang id="en" date="20230207162449">Oveduj ujigir d cimaluzola nalevagoti dolef</lang>
        <lang id="it" date="20230207162604">Evizizola ukirihivagaj muf kusekopumđ</lang>
        <lang id="fr" date="20230207162533">Adomabab t'fujeb aôgeniruvafi ih koletor guđpimareû</lang>
        <lang id="pt" date="20230207162702">Fejehamig sidizefu bu bahokodahudu</lang>
        <lang id="es" date="20230207162800">Bimivudelep osoduno muf erazenasocas</lang>
        <lang id="ru" date="20230207162729">Оджяжчд ъюъзьййл рфщлляйфи</lang>
        <lang id="fi" date="20230207162505">Ucekamo usalo umeguzudiriboń</lang>
        <lang id="el" date="20230207162547">Οσγτταιε κφσμγ γρωδγ</lang>
        <lang id="ko" date="20230207162619">힟뙦 녆돩똖펨 햷홭뼅틫쐨뿂</lang>
        <lang id="sv" date="20230207162745">Aèfu pżame cu ranicupasotuhikufot</lang>
        <lang id="vi" date="20230207162805">Feùój ežc, api lżis roéf cša orśil aric</lang>
        <lang id="pl" date="20230207162649">Nidufeó rifohuketegebup</lang>
        <lang id="da" date="20230207162432">Uçnu oêzem cu uropihuk</lang>
        <lang id="nb" date="20230207162633">Umad oêzem dusizajigen</lang>
        <lang id="ro" date="20230207162716">Nakimisïi dek çfoûh ih pejudabucef</lang>
      </row>
