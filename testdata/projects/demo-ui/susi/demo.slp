        <native>[AHI gapiz (hin. duzel 360 am, hin. usical 200 am)]</native>
        <lang id="de" date="20221121121347">AHI-Ezebefo azu 360 g 200 morșohav</lang>
        <lang id="en" date="20221215103646">AHI husud hijamav ko ac 360 g 200</lang>
        <lang id="it" date="20221215104007">Ohatepezigi ituneve zine AHI: 360 g 200</lang>
        <lang id="fr" date="20221215103843">Iniguted AHI epahipeïm zotom'è 360&#160;g&#160;200</lang>
        <lang id="pt" date="20221215104201">Vekopozivo naloboku AHI apý 360 g 200</lang>
        <lang id="es" date="20221215104321">Sa utigoki mepivanu AHI je igele 360 g 200</lang>
        <lang id="ru" date="20221215104235">Ийюхквшртф ыэпэфг AHI-щждхшя: 360 ю 200</lang>
        <lang id="fi" date="20221215103752">AHI-ukikujohu gonidçenupas da 360 g 200</lang>
        <lang id="el" date="20221215103927">Υψγηγψυρυρηο ζχιομτ AHI σχν 360 g 200</lang>
        <lang id="ko" date="20221215104041">칟롒 360 g 200 AHI 뢗츴 쓮컽</lang>
