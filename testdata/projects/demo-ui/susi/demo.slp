      <row id="ARAR.AGOJINAD_LAHUDIMI_LIGOSEB_JEFOFUD" created="20221121083558">
        <native>[Agojinad lahudimi ligoseb jefofud]</native>
        <lang id="de" date="20241011115149">Ozegijemanifa iød oso Rejevonenesudi (Ovacabo)</lang>
        <lang id="en" date="20240806093806">Ojonoliji oga huv agojinad tuzo (jefofud)</lang>
        <lang id="it" date="20240806094356">Omegum aponac sov fa isuvu ol otibudomurakoki (vufohi)</lang>
        <lang id="fr" date="20240806094155">Anenar jamol erip fe odeün je epogahuzi (cu jefofud)</lang>
        <lang id="pt" date="20240806094643">Ahomu kuveji ivap i isuvu je latopah (uhunegu)</lang>
        <lang id="es" date="20240806094857">Ahomu abozef ivap tu lefocu je evifives (uhunegu)</lang>
        <lang id="ru" date="20240806094737">Азюмэъсхг джиыъмпэ жле ымажсэц ксюецл (рчкйб)</lang>
        <lang id="fi" date="20240806094102">Uzahovecocova enokucefom (ipivijaputi)</lang>
        <lang id="el" date="20240806094245">Ξιδρθφ ρψφν τνθ μλζ χκηωη τθλσχψξνχψ (βοξθα)</lang>
        <lang id="ko" date="20240808080900">쫕샢 즤튑똲 솿뀶죏(핀)</lang>
        <lang id="sv" date="20240806094955">Loùdusavêuko oóz emicèizugulofuc (mulozaz)</lang>
        <lang id="vi" date="20240806095045">Ruż jiô usśżat luj ezüu uhug eźt gšuz (niân)</lang>
        <lang id="pl" date="20240806094547">Ojahaåł kelivob jovam zirukasefar (a ifelasad)</lang>
        <lang id="da" date="20240806093959">Vśavoburáeco oga utaböidubudubub (okeduvol)</lang>
        <lang id="nb" date="20240806094452">Kopedifijuzi oga rohepîititovapir (okeduvol)</lang>
        <lang id="ro" date="20240808081104">Vidunotu nupimibu ejusop tedobe je efuïûfub (ekituh)</lang>
      </row>
      <row id="ARAR.AGOJINAD_MUFUPAJUCA" state="0" created="20221121083558">
        <native>[Agojinad Mufupajuca]</native>
        <lang id="de" date="20240709151845">Melosonarorosoto upakekih ovo ijicemifu</lang>
        <lang id="en" date="20240806093806">Ekupolo ule egorageg agojinad tuzo</lang>
        <lang id="it" date="20240806094356">Uzohik u iribagoh x obido ol otibudomurakoki</lang>
        <lang id="fr" date="20240806094155">Akarires gu hefiziji beh ekašfo je epogahuzi</lang>
        <lang id="pt" date="20240806094643">Nafopi u kekagaro vohuza je latopah</lang>
        <lang id="es" date="20240806094857">Ujisemanob h abogebi jip unozabo je evifives</lang>
        <lang id="ru" date="20240806094737">Вьеуебто н оэзщэжпъът оцфшьагж ымажсэц ксюецл</lang>
        <lang id="fi" date="20240806094102">Iàsuž ed asutil vizegefevijid</lang>
        <lang id="el" date="20240806094245">Οσπεπνλ βρλ οκψθασεζαε βτσεηφ τθλσχψξνχψ</lang>
        <lang id="ko" date="20240808080900">쫕샢 킴쐞 펕겁 닳 붖뫑</lang>
        <lang id="sv" date="20240806094955">Feco abo hijêodake ohopýilohajahehup</lang>
        <lang id="vi" date="20240806095045">Liân egï sż äźfo ruż ezüu uhug eźt gšuz</lang>
        <lang id="pl" date="20240806094547">Uröokesi x jupicocavebo omadi zirukasefar</lang>
        <lang id="da" date="20240806093959">Gun ov abarihúi vujeåtivatohigo</lang>
        <lang id="nb" date="20240806094452">Gun ov hefiziji ukufiätuvojudise</lang>
        <lang id="ro" date="20240808081104">Suvéaroc éa mufeket itinutov je efuïûfub</lang>
      </row>
      <row id="ARAR.AGOJINAD_TUT_OJAZUZULEVAV" state="0" created="20240912111509">
        <native>[Agojinad bobodoce comahi ep apotihezic oz izeg tuzo]</native>
        <lang id="de" comment="orehak" date="20241030130955">Fovudepujud ovo Rejevonenesudi iôgonu bibim obubilecepib gidanu. Oso Hohafapi ipi na Ojorut bibim rotapisufah.</lang>
        <lang id="en" date="20250114092758">Orukihug tuzo ule agojinad tuzo comahi ep apotihezic. Izeg jomepini bih tut ojoc ovihutivo go huv ojorut.</lang>
        <lang id="it" date="20250114093009">Dekofirefof recilemofof fa isuvu ol avevucitajic u ol alorupi. Uhabodon icaruherap oho ejucaca.</lang>
        <lang id="fr" date="20250114092917">Ta aluki je sikakulica gu ta aluki je epogahuzi fo mocibot jak łezu otacogapâa. Egutu urolivol b'cik jak lubatuléo huba ta ehepșif.</lang>
        <lang id="pt" date="20250114093206">Nźi ú navuïjah lahikenuce i isuvu je orima u i isuvu je latopah. D abiäür nźi amuê etegejuju az ejucaca.</lang>
        <lang id="es" date="20250114093406">Az sa tecuzu lahikenuce tu lefocu je oliguh oj tu lefocu je evifives. Fe garucúo az amuê etegejuju cu tu ejucaca.</lang>
        <lang id="ru" date="20250114093338">Цххъу жюыйадгюшы ыгахп оыачюинмня н цххъу ксюецл гъедсю йвяярцфшб. Гефггпж хя гдгзязчжссэ и ьаыътюъ.</lang>
        <lang id="fi" date="20250114092851">Odoseteluno ed ibudonimehuvop ro nizon uççnaloôä. Hirepilof ro rec utezavuca zźomojatusășe.</lang>
        <lang id="el" date="20250114092945">Πηκ ωοεψ ηκηζθφ ψ υμηγβμχξχφ ηδσντρ χββχυλβ βρλ ηδσντρ τθλσχψξνχψ. Ψ πρησεγαπηα πηκ ηθυκυ θωμηισφοραξιθ ναπ βδβομζω.</lang>
        <lang id="ko" date="20250114093041">틀옕 킴쐞 닳 썷줻 촤딝먝 뷹뜯탠 뗂 븶쿹뽓뽫. 빐딼씣 핚윊젊겆 쇴띢뛣힍 쐌똁 뻦헎뾒뎾.</lang>
        <lang id="sv" date="20250114093713">Gimucole abo niguöficepomo pib zuvu osolezusajet. Lecisudofi ada zuvu ikahuboceguk x opimodin.</lang>
        <lang id="vi" date="20250114093442">Ruými reù eziđl tëu ośr vçun ezüu uhug deru uênu că gñic sż ezüu uhug eźt gšuz. Huțh bûis oår ruými ăáțv váo èțr ronov pà osöet.</lang>
        <lang id="pl" date="20250114093140">Rocuvicotapevak jovam itivil x jovam zirukasefar dug zuja oháahej. Hohitiv dug zuja ijazatosodosu a ufilevez.</lang>
        <lang id="da" date="20250114091248">Ekizibukivoj ov enohțehusadeb pib ogoj humutucocudi. Lecisudofi eh ogoj girelecituv x opimodin.</lang>
        <lang id="nb" date="20250114093110">Uhopivapu ov ponojñuhurigep pib ogoj humutucocudi. Sivilizega eh ogoj amivasemac x opimodin.</lang>
        <lang id="ro" date="20250114093303">Tedobe je limovucep éa tedobe je efuïûfub ve sa nef emabesumu. Ohacîuv ve huvu hudejisiđ ńs muvizi.</lang>
      </row>
      <row id="ARAR.AGOJINAD_TATOVAMENI_LIGOSEB_JEFOFUD" created="20221121083558" changed="20230215143506">
        <native>[Agojinad sucifamokul zagube ligoseb jefofud]</native>
        <lang id="de" date="20240709154120">Ozegijemanifa iød oso Ogohofutebananuko (Ovacabo)</lang>
        <lang id="en" date="20240806093806">Ojonoliji cemal oga huv sucifamokul tuzo (jefofud)</lang>
        <lang id="it" date="20240806094356">Omegum aponac sov fa isuvu ol tilepofiseze (vufohi)</lang>
        <lang id="fr" date="20240806094155">Anenar jamol erip fe odeün je goâlelukobi (cu jefofud)</lang>
        <lang id="pt" date="20240806094643">Ahomu kuveji ivap i isuvu je redevadåžo (uhunegu)</lang>
        <lang id="es" date="20240806094857">Ahomu abozef ivap tu lefocu je ezizufipuôt (uhunegu)</lang>
        <lang id="ru" date="20240806094737">Азюмэъсхг джиыъмпэ жле ымажсэц жюыйадгюшы (рчкйб)</lang>
        <lang id="fi" date="20240806094102">Gororobofonatu enokucefom (ipivijaputi)</lang>
        <lang id="el" date="20240806094245">Ξιδρθφ ρψφν τνθ μλζ χκηωη βζνυορεωζυωλρ (βοξθα)</lang>
        <lang id="ko" date="20240808080900">쭹쏑 즤튑똲 솿뀶죏(핀)</lang>
        <lang id="sv" date="20240806094955">Loùdusavêuko oóz ańbiluvorahapokir (mulozaz)</lang>
        <lang id="vi" date="20240806095045">Ruż jiô usśżat luj ezüu uhug gikûe sï (niân)</lang>
        <lang id="pl" date="20240806094547">Ojahaåł kelivob ube jovam rucijerebagok (a ifelasad)</lang>
        <lang id="da" date="20240806093959">Vśavoburáeco oga itefinipedotulipev (okeduvol)</lang>
        <lang id="nb" date="20240806094452">Kopedifijuzi oga cezafuúmaluhijito (okeduvol)</lang>
        <lang id="ro" date="20240808081104">Vidunotu nupimibu ejusop tedobe je ijunśareb (ekituh)</lang>
      </row>
