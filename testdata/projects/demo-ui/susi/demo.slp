      <row id="ARAR.ORUKIHUG_LAHUDIMI_LIGOSEB_JEFOFUD" state="0" created="20240614134227">
        <native>[Orukihug lahudimi ligoseb jefofud]</native>
        <lang id="de" date="20240709154224">Ozegijemanifa iød oso Fovudepujud (Ovacabo)</lang>
        <lang id="en" date="20240806093806">Ojonoliji cemal oga huv orukihug tuzo (jefofud)</lang>
        <lang id="it" date="20240806094357">Omegum aponac sov fa isuvu ol avevucitajic (vufohi)</lang>
        <lang id="fr" date="20240806094155">Anenar jamol erip ta aluki je sikakulica (cu jefofud)</lang>
        <lang id="pt" date="20240806094643">Ahomu kuveji ivap i isuvu je orima (uhunegu)</lang>
        <lang id="es" date="20240806094857">Ahomu abozef ivap tu lefocu je oliguh (uhunegu)</lang>
        <lang id="ru" date="20240806094737">Азюмэъсхг джиыъмпэ жле ымажсэц жюыйадгюшы ыгахп оыачюинмня (рчкйб)</lang>
        <lang id="fi" date="20240806094102">Amebufegib enokucefom (ipivijaputi)</lang>
        <lang id="el" date="20240806094245">Ξιδρθφ ρψφν τνθ μλζ χκηωη χββχυλβ (βοξθα)</lang>
        <lang id="ko" date="20240808080900">틀옕 즤튑똲 솿뀶죏(핀)</lang>
        <lang id="sv" date="20240806094955">Loùdusavêuko oóz edosibojoc (mulozaz)</lang>
        <lang id="vi" date="20240806095045">Ruż jiô usśżat ezüu uhug deru uênu că gñic (niân)</lang>
        <lang id="pl" date="20240806094547">Ojahaåł kelivob jovam itivil (a ifelasad)</lang>
        <lang id="da" date="20240806093959">Vśavoburáeco oga tabisobepik (okeduvol)</lang>
        <lang id="nb" date="20240806094452">Kopedifijuzi oga ojezodacuvu (okeduvol)</lang>
        <lang id="ro" date="20240808081104">Vidunotu nupimibu ejusop tedobe je limovucep (ekituh)</lang>
      </row>
      <row id="ARAR.ORUKIHUG_MUFUPAJUCA" state="0" created="20240614134227">
        <native>[Orukihug Mufupajuca]</native>
        <lang id="de" date="20240709151645">Usizimotomegu upakekih ovo ijicemifu</lang>
        <lang id="en" date="20240806093806">Ekupolo ule egorageg orukihug rujuj</lang>
        <lang id="it" date="20240806094357">Uzohik u iribagoh x obido ol avevucitajic</lang>
        <lang id="fr" date="20240806094155">Akarires gu hefiziji beh aluki je sikakulica</lang>
        <lang id="pt" date="20240806094643">Nafopi u kekagaro vohuza je orima</lang>
        <lang id="es" date="20240806094857">Ujisemanob h abogebi jip unozabo je oliguh</lang>
        <lang id="ru" date="20240806094737">Вьеуебто н оэзщэжпъът оцфшьагж ымажсэц жюыйадгюшы ыгахп оыачюинмня</lang>
        <lang id="fi" date="20240806094102">Iàsuž ed asutil netecagiri</lang>
        <lang id="el" date="20240806094245">Οσπεπνλ βρλ οκψθασεζαε βτσεηφ χββχυλβ</lang>
        <lang id="ko" date="20240808080900">틀옕 킴쐞 펕겁 닳 붖뫑</lang>
        <lang id="sv" date="20240806094955">Feco abo hijêodake fajutofitike</lang>
        <lang id="vi" date="20240806095045">Liân egï sż äźfo ruż ezüu uhug deru uênu că gñic</lang>
        <lang id="pl" date="20240806094547">Uröokesi x jupicocavebo omadi efofu</lang>
        <lang id="da" date="20240806093959">Gun ov abarihúi zitatekutoj</lang>
        <lang id="nb" date="20240806094452">Gun ov hefiziji ucidihucobe</lang>
        <lang id="ro" date="20240808081104">Suvéaroc éa mufeket itinutov je limovucep</lang>
      </row>
