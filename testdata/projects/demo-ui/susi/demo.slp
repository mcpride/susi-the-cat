        <lang id="en" date="20200608161051">Ibacami egili, UZ tugidan</lang>
        <lang id="it" date="20200608161930">Nehuto jikemug fa ukecujinumu: UZ ufufipinogu</lang>
        <lang id="fr" date="20200608161335">Sogoka cino ik davakogilu, UZ imoleci</lang>
        <lang id="pt" date="20200608161651">Afur ne decidavo, UZ iledavuzuter</lang>
        <lang id="es" date="20200608161243">Egili de velaho, UZ dipusakimog</lang>
        <lang id="ru" date="20200608161744">Мнкфдй есф ьгйжбнте, ияциуэщнахртэ шххтпдыющй</lang>
        <lang id="fi" date="20210317142921">Gimokanesef, bubamasudu ovifuz</lang>
        <lang id="el" date="20210720103252">Ελξμιν εαλο αθ αιλσλγχ, ιαθπμφι UZ</lang>
        <lang id="ko" date="20210719161712">꼘쿎 픓 핛뿨, 쓿 뗂 띞롔 UZ</lang>
        <lang id="sv" date="20210719161540">Kul eja ehudunen, UZ ozøaz</lang>
        <lang id="vi" date="20210720103320">Ošg iri dùi, UZ ruými tçu üóce</lang>
        <lang id="pl" date="20210719161638">Ulodocu epapuhoneb hinuëmoó hóło, oluzufov UZ</lang>
        <lang id="da" date="20221215103302">Ejoh ozoja leraúzigod, UZ husipi</lang>
        <lang id="nb" date="20221215103403">Ecaz los nazolaf, UZ arebos</lang>
        <lang id="ro" date="20221215103532">Fozobi fe śkiñvohap, UZ zocakucofa</lang>
      </row>
      <row id="EGILI.TUGIDAN_MUBOZI_EGILI" state="0" created="20200506135053">
