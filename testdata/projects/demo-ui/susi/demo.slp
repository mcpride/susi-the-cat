        <lang id="fr">{{ jefofud }} jefofud gasetid</lang>
        <lang id="pt">Pùigod je {{ jefofud }} uhunegu</lang>
        <lang id="es">Pùigod {{ jefofud }} uhunegu</lang>
        <lang id="ru">Йчнхяъхч {{ jefofud }} цкоыйю</lang>
        <lang id="fi">Ekebiäâf {{ jefofud }} pirerofos</lang>
        <lang id="el">Τγοσπζν {{ jefofud }} βοξθα</lang>
        <lang id="ko">칟롒 {{ jefofud }}핀</lang>
        <lang id="sv">Ukulezuv {{ jefofud }} mulozaz</lang>
        <lang id="vi">Uțn üg {{ jefofud }} niân</lang>
