      <row id="ARAR.PEDOKUTOZIDU_OCOHU" state="0" created="20200506135053">
        <native>[Bas iretah bih ojoc ocohu pedokutozidu]</native>
        <lang id="de" date="20200506173654">Vem tita Civusoh ulevi icojefajțat</lang>
        <lang id="en" date="20200608161051">Huv bas okovo bih ojoc ocohu.</lang>
        <lang id="it" date="20200608161930">Fe orobe osoc ś maraf anurovuj</lang>
        <lang id="fr" date="20200608161335">Fe birukuho dapețk d țoó bomupša</lang>
        <lang id="pt" date="20200608161651">D afus ucizado dog uzejesanek</lang>
        <lang id="es" date="20200608161243">Sa pi tçojopu fe samog ucizado</lang>
        <lang id="ru" date="20200608161744">Сэосн члнрцй мэши тсеявтыкг</lang>
        <lang id="fi" date="20210317142921">Zuju upekacuü hedïazici</lang>
        <lang id="el" date="20210720103252">Ψ στμ ζαπβτγμκφχ δωπιθιφγωθ</lang>
        <lang id="ko" date="20210719161712">츁 퉩셣쁮 톳씬뷠</lang>
        <lang id="sv" date="20210719161540">Ifu oro agozed vemej lapo</lang>
        <lang id="vi" date="20210720103320">Šš urși cša fùo reøn</lang>
        <lang id="pl" date="20210719161638">Isanos mino bopi</lang>
        <lang id="da" date="20221215103302">Ifu eno enah cigu hasođkut</lang>
        <lang id="nb" date="20221215103403">Ifu eno esukžusagih umu aduk bot</lang>
        <lang id="ro" date="20221215103532">Aviv âtepanonufen d evub ojäucuvł</lang>
      </row>
      <row id="ARAR.PEDOKUTOZIDU_JELUNIR" state="0" created="20200506135053">
        <native>[Huv iretah bih ojoc jelunir pedokutozidu]</native>
        <lang id="de" date="20200506173658">Vem Civusoh ulevi gelâovuk</lang>
        <lang id="en" date="20200608161051">Huv okovo bih ojoc jelunir.</lang>
        <lang id="it" date="20200608161930">Fe osoc ś maraf ugihokota</lang>
        <lang id="fr" date="20200608161335">F’dapețk d țoó tadebepżu</lang>
        <lang id="pt" date="20200608161651">D ucizado dog ecevuîzi</lang>
        <lang id="es" date="20200608161243">Sa pi ebumogo fe ucizado</lang>
        <lang id="ru" date="20200608161744">Члнрцй мэши эчвхчщц</lang>
        <lang id="fi" date="20210317142921">Upekacuü tipavogobeh</lang>
        <lang id="el" date="20210720103252">Ψ ζαπβτγμκφχ αικχσβκαωω</lang>
        <lang id="ko" date="20210719161712">퉩셣쁮 튦몷남</lang>
        <lang id="sv" date="20210719161540">Agozed socesuhaz</lang>
        <lang id="vi" date="20210720103320">Cša fùo reøn šš sï uàt</lang>
        <lang id="pl" date="20210719161638">Bopi ivamoé ugigiádi</lang>
        <lang id="da" date="20221215103302">Agozed cigu osifesu</lang>
        <lang id="nb" date="20221215103403">Esukžusagih umu osifesu</lang>
        <lang id="ro" date="20221215103532">Ńepelotihodej d evub êhomagê</lang>
      </row>
      <row id="ARAR.PEDOKUTOZIDU_JECIGI" state="0" created="20200506135053">
        <native>[Huv iretah bih ojoc jecigi pedokutozidu]</native>
        <lang id="de" date="20241120132350">Oso Utisupusezana madode zorapalegor.</lang>
        <lang id="en" date="20241120132351">Huv bobodoce egit ojoc mizuz.</lang>
        <lang id="it" date="20250114093009">Molohifejada hizenat.</lang>
        <lang id="fr" date="20250114092917">Beh lèahohec rir țoó kotanabavàe.</lang>
        <lang id="pt" date="20250114093207">Al valukin adobe dodiso.</lang>
        <lang id="es" date="20250114093407">Sa ove olelubat jip valukin.</lang>
        <lang id="ru" date="20250114093339">Аоаытсютз аэюп оебыбшььц.</lang>
        <lang id="fi" date="20250114092851">Idenumebe ijipudigajepo.</lang>
        <lang id="el" date="20250114092945">Γε ζραηφξλμρ γψπωτμρηλαμιη.</lang>
        <lang id="ko" date="20250114093041">눃쪸럵 굄귧밹퀺밠첥돣.</lang>
        <lang id="sv" date="20250114093713">Ahajüadisovabod ada labosaj.</lang>
        <lang id="vi" date="20250114093442">Cși váo èțr šš ăáțv aøv pça.</lang>
        <lang id="pl" date="20250114093140">Avoriguhoc efoboäv ehecihup.</lang>
        <lang id="da" date="20250114091248">Tazalizimefajec cigu ilic.</lang>
        <lang id="nb" date="20250114093110">Ucanofisirikig eh jumoju.</lang>
        <lang id="ro" date="20250114093303">Obaédibu il evub hizenat.</lang>
      </row>
      <row id="ARAR.FAFU_AGUL_ACOLERUH" state="0" created="20221121083558">
        <native>[Fafu agul acoleruh]</native>
        <lang id="de" date="20221121120940">Ehoju odi Cakareputoz łzipolitug</lang>
        <lang id="en" date="20221215103646">Fafu ehak agul acoleruh</lang>
        <lang id="it" date="20221215104007">Unelukidih tahu ujev'ifucered</lang>
        <lang id="fr" date="20221215103843">Hetakivon beh ecirśun je f'uåmijuh</lang>
        <lang id="pt" date="20221215104201">Jabovod kogat eg acoleruh</lang>
        <lang id="es" date="20221215104321">Cibibog zefeh oku acoleruh</lang>
        <lang id="ru" date="20221215104235">Жскчыяр мржпзл щ цещуаацй</lang>
        <lang id="fi" date="20221215103752">Eçceä ahohojide okibade</lang>
        <lang id="el" date="20221215103927">Λτζσιλξ ωοηζβξβιμ μγσ ωψκπλρυαβχ</lang>
        <lang id="ko" date="20221215104041">곜멝 룷뼴멑 븱뾥</lang>
        <lang id="sv" date="20221215104408">Ùmaden ehak ad makulogub</lang>
        <lang id="vi" date="20221215104453">Eñt eż haüf cù dñon duèf</lang>
        <lang id="pl" date="20221215104112">Avijenef ekos cusekafa</lang>
        <lang id="da" date="20221215103302">Erotid ehak tez acoleruh</lang>
        <lang id="nb" date="20221215103403">Ehasuc ehak oga hivozuv</lang>
        <lang id="ro" date="20221215103532">Zehujotal ocalutu je fe satidu</lang>
      </row>
      <row id="ARAR.FAFU_AGUL_JOHIKIJUV_ZUBO" state="0" created="20221121083558">
        <native>[Fafu agul johikijuv zubo]</native>
        <lang id="de" date="20221121120953">Ehoju odi Isijehuniba łzipolitug</lang>
        <lang id="en" date="20221215103646">Fafu ehak agul johikijuv zubo</lang>
        <lang id="it" date="20221215104007">Unelukidih tahu aso laku ol cijasodog</lang>
        <lang id="fr" date="20221215103843">Hetakivon beh ecirśun ik zubo je ininłavid</lang>
        <lang id="pt" date="20221215104201">Jabovod kogat eg laku je ekopabodocop</lang>
        <lang id="es" date="20221215104321">Cibibog zefeh oku laku je utinevacuketi</lang>
        <lang id="ru" date="20221215104235">Жскчыяр мржпзл щ фхна эпхыгжвзц</lang>
        <lang id="fi" date="20221215103752">Eçceä tujidebisirijelo okibade</lang>
        <lang id="el" date="20221215103927">Λτζσιλξ ωοηζβξβιμ μγσ πεξχ ιφβοκνχζδτψ</lang>
        <lang id="ko" date="20221215104041">쫈쿧 푈걒 룷뼴멑 븱뾥</lang>
        <lang id="sv" date="20221215104408">Ùmaden ehak ad agucecejufune</lang>
        <lang id="vi" date="20221215104453">Eñt eż haüf cù okżu ekø cuvńo</lang>
        <lang id="pl" date="20221215104112">Avijenef ekos osan ekipudela</lang>
        <lang id="da" date="20221215103302">Erotid ehak tez emimahakufeji</lang>
        <lang id="nb" date="20221215103403">Ehasuc ehak oga rubacicudepad</lang>
        <lang id="ro" date="20221215103532">Zehujotal ocalutu je fe itemi ozosipupeh</lang>
      </row>
