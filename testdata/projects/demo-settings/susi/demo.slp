        <lang id="nb" date="20250115104520">Ulujora</lang>
        <lang id="ro" date="20250115104520">Ve cusul me ikepufi</lang>
      </row>
      <row id="EHOZUSAZALEC.ROGI_BOBODOCE_BOKUSO" state="0" created="20240926153145">
        <native>[Bokuso ac rogi bobodoce]</native>
        <lang id="de" comment="orehak" date="20241008091711">Odedecopu cecanagunefahu</lang>
        <lang id="en" date="20250115104540">Bokuso ac rogi bobodoce</lang>
        <lang id="it" date="20250115104540">Zacojovomuh ise hudefuku</lang>
        <lang id="fr" date="20250115104540">Łjipa je f’fizicevecaloru</lang>
        <lang id="pt" date="20250115104540">Bavonufifop atagov</lang>
        <lang id="es" date="20250115104540">Az sa pi hiropu sobinib</lang>
        <lang id="ru" date="20250115104540">Хя неяюягк фюзршвркс мржпзл</lang>
        <lang id="fi" date="20250115104540">Emumukuva maùzuzajizi</lang>
        <lang id="el" date="20250115104540">Ψ ψκκινγρκαφ συεορδχ</lang>
        <lang id="ko" date="20250115104540">힊뭺 쨚퉾</lang>
        <lang id="pl" date="20250115104540">Ceguvosecic dug titehaàj ibź</lang>
        <lang id="sv" date="20250115104540">Ibus zuvu gut amile</lang>
        <lang id="vi" date="20250115104540">Aøv ruými taćmi nëuh</lang>
        <lang id="da" date="20250115104520">Dujamiv obahepemaho</lang>
        <lang id="nb" date="20250115104540">Dujamiv lasofazid</lang>
        <lang id="ro" date="20250115104540">Ofitefo oüligž</lang>
      </row>
      <row id="EHOZUSAZALEC.ROGI_BOBODOCE_ZODUTIS" state="0" created="20240926153145">
        <native>[Bobodoce bih ojoc mizuz pedokutozidu]</native>
        <lang id="de" comment="orehak" date="20241120142129">Oso Utisupusezana madode zorapalegor.</lang>
        <lang id="en" date="20241120142129">Huv bobodoce egit ojoc mizuz.</lang>
        <lang id="it" date="20250115104540">Molohifejada hizenat.</lang>
        <lang id="fr" date="20250115104540">Beh lèahohec rir țoó kotanabavàe.</lang>
        <lang id="pt" date="20250115104540">Al valukin adobe dodiso.</lang>
        <lang id="es" date="20250115104540">Sa ove olelubat jip valukin.</lang>
        <lang id="ru" date="20250115104540">Аоаытсютз аэюп оебыбшььц.</lang>
        <lang id="fi" date="20250115104540">Idenumebe ijipudigajepo.</lang>
        <lang id="el" date="20250115104540">Γε ζραηφξλμρ γψπωτμρηλαμιη.</lang>
        <lang id="ko" date="20250115104540">눃쪸럵 굄귧밹퀺밠첥돣.</lang>
        <lang id="pl" date="20250115104540">Avoriguhoc efoboäv ehecihup.</lang>
        <lang id="sv" date="20250115104540">Ahajüadisovabod ada labosaj.</lang>
        <lang id="vi" date="20250115104540">Cși váo èțr šš ăáțv aøv pça.</lang>
        <lang id="da" date="20250115104540">Tazalizimefajec cigu ilic.</lang>
        <lang id="nb" date="20250115104540">Ucanofisirikig eh jumoju.</lang>
        <lang id="ro" date="20250115104540">Obaédibu il evub hizenat.</lang>
      </row>
