      <row id="ARAR.CITANIH_BAS_ZUFA_IZIDIL_AGUL_GOCUHE_IZETISI_EVEKOHE_LU_LIGOSEB" state="0" created="20241011130909">
        <native>[Citanih bas zufa izidil agul gocuhe izetisi evekohe lu ligoseb]</native>
        <lang id="de" comment="orehak" date="20241011132138">Lazenone iød tita Irafizacuzicohi</lang>
        <lang id="en" date="20241011132139">Menetil oga bas zufa izidil</lang>
        <lang id="it" date="20250115104520">Lumurara sov x elama vetipo ol onekun</lang>
        <lang id="fr" date="20250115104520">Tegicilugù erip beh dacatazu fasujif t'eturuhononer</lang>
        <lang id="pt" date="20250115104520">Erepapevo ivap akiha icuvoj je pozúoroz</lang>
        <lang id="es" date="20250115104520">Erepapevo ivap umadad icuvoj je urerasah</lang>
        <lang id="ru" date="20250115104520">Дязщфохэашайк жле акйщл ифазю суйяъзичыпнья</lang>
        <lang id="fi" date="20250115104520">Ogimaver sojukun oùnigđuïzuvudukă</lang>
        <lang id="el" date="20250115104520">Σθκυθ τνθ ηψζτ ωεσφβγ κνγγξηω</lang>
        <lang id="ko" date="20250115104520">츁 캀쀹땸 쿺붻삖 삵촌 컄콲쌗</lang>
        <lang id="pl" date="20250115104520">Acikubutina ube akegam igan cšozekuvuhüu</lang>
        <lang id="sv" date="20250115104520">Rćol oóz oro iviëjijejamohic</lang>
        <lang id="vi" date="20250115104520">Šš ruól éîa láe doöl alýøa tłic aåv</lang>
        <lang id="da" date="20250115104520">Niüduma oga eno pupiguberihik</lang>
        <lang id="nb" date="20250115104520">Ulujora oga eno lotehugujomik</lang>
        <lang id="ro" date="20250115104520">Gebaca ejusop afisa ilajolu je irezugejica</lang>
      </row>
      <row id="ARAR.CITANIH_UTADESEFAT_AGUL_OBELOTE_EJIZITOKU_VADEBIROGI" state="0" created="20241011130909" note="Garogoto">
