      <row id="INUBEV.JIBEMOZEPID" state="0" created="20250820102913" note="Kejerunilababo-Ohezezes: Orerusop &quot;Ukirijusab&quot; ojoj &quot;Ilim&quot;">
        <native>[Jibemozepid]</native>
        <lang id="de" date="20250912115305">Ohezezes</lang>
        <lang id="en" date="20250912115317">Jibemozepid</lang>
        <lang id="it" date="20250926142405">Atoribep</lang>
        <lang id="fr" date="20250926141955">Ledusimocitad</lang>
        <lang id="pt" date="20250926142755">Atoribep</lang>
