      </row>
      <row id="Only rows changed since D: 2026-11-01, &quot;2026-11-01 14:30&quot;, today, yesterday, 7d (days), 12h (hours)." created="20261103232009" note="Date options" notereadonly="1">
        <native>Only rows changed since D: 2026-11-01, "2026-11-01 14:30", today, yesterday, 7d (days), 12h (hours).</native>
        <lang id="de" date="20261103232009" status="3">Nur seit D geänderte Zeilen: 2026-11-01, "2026-11-01 14:30", today, yesterday, 7d (Tage), 12h (Stunden).</lang>
      </row>
      <row id="Only rows changed until D (a date without time includes the whole day)." created="20261103232009" note="Date options" notereadonly="1">
        <native>Only rows changed until D (a date without time includes the whole day).</native>
        <lang id="de" date="20261103232009" status="3">Nur bis D geänderte Zeilen (ein Datum ohne Uhrzeit schließt den ganzen Tag ein).</lang>
      </row>
      <row id="Timestamp checked by -since/-until:" created="20261103232009" note="Date options" notereadonly="1">
        <native>Timestamp checked by -since/-until:</native>
        <lang id="de" date="20261103232009" status="3">Von -since/-until geprüfter Zeitstempel:</lang>
      </row>
      <row id="@plural|{n} row matches the date filter|{n} rows match the date filter" created="20261103232009" note="Date options#lContext: @plural" notereadonly="1">
        <native>{n} row matches the date filter|{n} rows match the date filter</native>
        <lang id="de" date="20261103232009" status="3">{n} Zeile entspricht dem Datumsfilter|{n} Zeilen entsprechen dem Datumsfilter</lang>
      </row>
      <row id="Manage screenshots of rows (context for translators)" created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Manage screenshots of rows (context for translators)</native>
        <lang id="de" date="20261118153954" status="3">Screenshots zu Zeilen verwalten (Kontext für Übersetzer)</lang>
      </row>
      <row id="Screenshots as context for translators. They are stored next to the project in\n&lt;project&gt;.files/ (screenshots.json and the images); the project file stays unchanged." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Screenshots as context for translators. They are stored next to the project in#l&lt;project&gt;.files/ (screenshots.json and the images); the project file stays unchanged.</native>
        <lang id="de" date="20261118153954" status="3">Screenshots als Kontext für Übersetzer. Sie liegen neben dem Projekt in#l&lt;Projekt&gt;.files/ (screenshots.json und die Bilder); die Projektdatei bleibt unverändert.</lang>
      </row>
      <row id="Lists the screenshots and their links (default)." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Lists the screenshots and their links (default).</native>
        <lang id="de" date="20261118153954" status="3">Listet die Screenshots und ihre Verknüpfungen auf (Standard).</lang>
      </row>
      <row id="Adds image files (PNG, JPEG); with -key also links them." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Adds image files (PNG, JPEG); with -key also links them.</native>
        <lang id="de" date="20261118153954" status="3">Fügt Bilddateien hinzu (PNG, JPEG); mit -key werden sie auch verknüpft.</lang>
      </row>
      <row id="Links screenshot ID to the rows given by -key." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Links screenshot ID to the rows given by -key.</native>
        <lang id="de" date="20261118153954" status="3">Verknüpft Screenshot ID mit den Zeilen aus -key.</lang>
      </row>
      <row id="Removes the links of screenshot ID to the rows given by -key." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Removes the links of screenshot ID to the rows given by -key.</native>
        <lang id="de" date="20261118153954" status="3">Entfernt die Verknüpfungen von Screenshot ID zu den Zeilen aus -key.</lang>
      </row>
      <row id="Removes screenshots." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Removes screenshots.</native>
        <lang id="de" date="20261118153954" status="3">Entfernt Screenshots.</lang>
      </row>
      <row id="Removes links to rows that no longer exist and unused image files." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Removes links to rows that no longer exist and unused image files.</native>
        <lang id="de" date="20261118153954" status="3">Entfernt Verknüpfungen zu nicht mehr vorhandenen Zeilen und unbenutzte Bilddateien.</lang>
      </row>
      <row id="Reads changed origin files again (links stay)." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Reads changed origin files again (links stay).</native>
        <lang id="de" date="20261118153954" status="3">Liest geänderte Herkunftsdateien neu ein (Verknüpfungen bleiben).</lang>
      </row>
      <row id="Imports a manifest of a UI test run (schema of screenshots.json, file paths\nrelative to the manifest); importing again replaces the screenshots." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Imports a manifest of a UI test run (schema of screenshots.json, file paths#lrelative to the manifest); importing again replaces the screenshots.</native>
        <lang id="de" date="20261118153954" status="3">Importiert das Manifest eines UI-Testlaufs (Schema von screenshots.json, Dateipfade#lrelativ zum Manifest); ein erneuter Import ersetzt die Screenshots.</lang>
      </row>
      <row id="Rows: contexts or row ids separated by ;, wildcards * and ? allowed." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Rows: contexts or row ids separated by ;, wildcards * and ? allowed.</native>
        <lang id="de" date="20261118153954" status="3">Zeilen: Kontexte oder Zeilen-IDs, getrennt durch ;, Platzhalter * und ? erlaubt.</lang>
      </row>
      <row id="Only rows of this source." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Only rows of this source.</native>
        <lang id="de" date="20261118153954" status="3">Nur Zeilen dieser Quelle.</lang>
      </row>
      <row id="add: id of the screenshot (default: from the file name; an existing id\ngets the new image)." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>add: id of the screenshot (default: from the file name; an existing id#lgets the new image).</native>
        <lang id="de" date="20261118153954" status="3">add: ID des Screenshots (Standard: aus dem Dateinamen; eine vorhandene ID#lerhält das neue Bild).</lang>
      </row>
      <row id="add: title." created="20261118153954" note="Screenshots" notereadonly="1">
        <native>add: title.</native>
        <lang id="de" date="20261118153954" status="3">add: Titel.</lang>
      </row>
