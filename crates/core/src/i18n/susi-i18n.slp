        <native>Invalid value for -{name}: "{value}"</native>
        <lang id="de" date="20261103155355" status="3">Ungültiger Wert für -{name}: "{value}"</lang>
      </row>
      <row id="Unknown option -{option} for task '{task}' (see: susi-cli {task} -h)" state="0" created="20261103155355" note="Command line parsing" notereadonly="1">
        <native>Unknown option -{option} for task '{task}' (see: susi-cli {task} -h)</native>
        <lang id="de" date="20261103155355" status="3">Unbekannte Option -{option} für Task '{task}' (siehe: susi-cli {task} -h)</lang>
      </row>
      <row id="Ambiguous option -{option} for task '{task}'" state="0" created="20261103155355" note="Command line parsing" notereadonly="1">
        <native>Ambiguous option -{option} for task '{task}'</native>
        <lang id="de" date="20261103155355" status="3">Mehrdeutige Option -{option} für Task '{task}'</lang>
      </row>
      <row id="Option -{option} before the first task" state="0" created="20261103155355" note="Command line parsing" notereadonly="1">
        <native>Option -{option} before the first task</native>
        <lang id="de" date="20261103155355" status="3">Option -{option} vor dem ersten Task</lang>
      </row>
