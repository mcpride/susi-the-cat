        <lang id="de" date="20261118153954" status="3">(keine passende Zeile)</lang>
      </row>
      <row id="Screenshots saved: {path}" created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Screenshots saved: {path}</native>
        <lang id="de" date="20261118153954" status="3">Screenshots gespeichert: {path}</lang>
      </row>
      <row id="Screenshots: {summary} ({path})" created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Screenshots: {summary} ({path})</native>
        <lang id="de" date="20261118153954" status="3">Screenshots: {summary} ({path})</lang>
      </row>
      <row id="{added} screenshots added, {replaced} replaced, {removed} removed, {links} links" created="20261118153954" note="Screenshots" notereadonly="1">
        <native>{added} screenshots added, {replaced} replaced, {removed} removed, {links} links</native>
        <lang id="de" date="20261118153954" status="3">{added} Screenshots hinzugefügt, {replaced} ersetzt, {removed} entfernt, {links} Verknüpfungen</lang>
      </row>
      <row id="{links} orphaned links removed, {files} unused image files deleted" created="20261118153954" note="Screenshots" notereadonly="1">
        <native>{links} orphaned links removed, {files} unused image files deleted</native>
        <lang id="de" date="20261118153954" status="3">{links} verwaiste Verknüpfungen entfernt, {files} unbenutzte Bilddateien gelöscht</lang>
      </row>
      <row id="{updated} screenshots updated, {unchanged} unchanged" created="20261118153954" note="Screenshots" notereadonly="1">
        <native>{updated} screenshots updated, {unchanged} unchanged</native>
        <lang id="de" date="20261118153954" status="3">{updated} Screenshots aktualisiert, {unchanged} unverändert</lang>
      </row>
      <row id="@plural|{n} screenshot|{n} screenshots" created="20261118153954" note="Screenshots#lContext: @plural" notereadonly="1">
        <native>{n} screenshot|{n} screenshots</native>
        <lang id="de" date="20261118153954" status="3">{n} Screenshot|{n} Screenshots</lang>
      </row>
      <row id="@plural|{n} link|{n} links" created="20261118153954" note="Screenshots#lContext: @plural" notereadonly="1">
        <native>{n} link|{n} links</native>
        <lang id="de" date="20261118153954" status="3">{n} Verknüpfung|{n} Verknüpfungen</lang>
      </row>
      <row id="@plural|{n} orphaned link|{n} orphaned links" created="20261118153954" note="Screenshots#lContext: @plural" notereadonly="1">
        <native>{n} orphaned link|{n} orphaned links</native>
        <lang id="de" date="20261118153954" status="3">{n} verwaiste Verknüpfung|{n} verwaiste Verknüpfungen</lang>
      </row>
      <row id="@plural|{n} row linked|{n} rows linked" created="20261118153954" note="Screenshots#lContext: @plural" notereadonly="1">
        <native>{n} row linked|{n} rows linked</native>
        <lang id="de" date="20261118153954" status="3">{n} Zeile verknüpft|{n} Zeilen verknüpft</lang>
      </row>
      <row id="@plural|{n} link removed|{n} links removed" created="20261118153954" note="Screenshots#lContext: @plural" notereadonly="1">
        <native>{n} link removed|{n} links removed</native>
        <lang id="de" date="20261118153954" status="3">{n} Verknüpfung entfernt|{n} Verknüpfungen entfernt</lang>
      </row>
      <row id="@plural|{n} link does not match any row|{n} links do not match any row" created="20261118153954" note="Screenshots#lContext: @plural" notereadonly="1">
        <native>{n} link does not match any row|{n} links do not match any row</native>
        <lang id="de" date="20261118153954" status="3">{n} Verknüpfung passt zu keiner Zeile|{n} Verknüpfungen passen zu keiner Zeile</lang>
      </row>
      <row id="Copy the original or another language" created="20261120220922" note="Copy" notereadonly="1">
        <native>Copy the original or another language</native>
        <lang id="de" date="20261120220922" status="3">Original oder eine andere Sprache übernehmen</lang>
      </row>
      <row id="Copies the original or the translations of another language into the given languages\n(Row/Column | Copy from), e.g. to fill de-CH from de. Only empty cells are filled unless\n-overwrite is given. Rows marked &quot;Do not translate&quot;, excluded rows and rows without text to\ncopy are skipped; the status changes as when editing a cell." created="20261120220922" note="Copy" notereadonly="1">
        <native>Copies the original or the translations of another language into the given languages#l(Row/Column | Copy from), e.g. to fill de-CH from de. Only empty cells are filled unless#l-overwrite is given. Rows marked "Do not translate", excluded rows and rows without text to#lcopy are skipped; the status changes as when editing a cell.</native>
        <lang id="de" date="20261120220922" status="3">Übernimmt das Original oder die Übersetzungen einer anderen Sprache in die angegebenen#lSprachen (Zeile/Spalte | Übernehmen), z. B. um de-CH aus de zu füllen. Ohne -overwrite werden#lnur leere Zellen gefüllt. Zeilen mit „Nicht übersetzen“, ausgeschlossene Zeilen und Zeilen#lohne Text zum Übernehmen werden übersprungen; der Status ändert sich wie beim Bearbeiten.</lang>
      </row>
      <row id="Target languages, separated by ; (required)." created="20261120220922" note="Copy" notereadonly="1">
        <native>Target languages, separated by ; (required).</native>
        <lang id="de" date="20261120220922" status="3">Zielsprachen, getrennt durch ; (erforderlich).</lang>
      </row>
      <row id="Language to copy from (default: the original)." created="20261120220922" note="Copy" notereadonly="1">
        <native>Language to copy from (default: the original).</native>
        <lang id="de" date="20261120220922" status="3">Sprache, aus der übernommen wird (Standard: das Original).</lang>
      </row>
      <row id="-from and -lang must not contain the same language ({lang})" created="20261120220922" note="Copy" notereadonly="1">
        <native>-from and -lang must not contain the same language ({lang})</native>
        <lang id="de" date="20261120220922" status="3">-from und -lang dürfen nicht dieselbe Sprache enthalten ({lang})</lang>
      </row>
      <row id="@plural|{n} cell copied from the original to {lang}|{n} cells copied from the original to {lang}" state="0" created="20261127162806" note="Copy#lContext: @plural" notereadonly="1">
        <native>{n} cell copied from the original to {lang}|{n} cells copied from the original to {lang}</native>
        <lang id="de" date="20261127162806" status="3">{n} Zelle aus dem Original in {lang} übernommen|{n} Zellen aus dem Original in {lang} übernommen</lang>
      </row>
      <row id="@plural|{n} cell copied from {from} to {lang}|{n} cells copied from {from} to {lang}" state="0" created="20261127162806" note="Copy#lContext: @plural" notereadonly="1">
        <native>{n} cell copied from {from} to {lang}|{n} cells copied from {from} to {lang}</native>
        <lang id="de" date="20261127162806" status="3">{n} Zelle aus {from} in {lang} übernommen|{n} Zellen aus {from} in {lang} übernommen</lang>
      </row>
      <row id="@plural|{n} cell with a translation was kept (-overwrite replaces it)|{n} cells with a translation were kept (-overwrite replaces them)" created="20261120220922" note="Copy#lContext: @plural" notereadonly="1">
        <native>{n} cell with a translation was kept (-overwrite replaces it)|{n} cells with a translation were kept (-overwrite replaces them)</native>
        <lang id="de" date="20261120220922" status="3">{n} Zelle mit Übersetzung beibehalten (-overwrite ersetzt sie)|{n} Zellen mit Übersetzung beibehalten (-overwrite ersetzt sie)</lang>
      </row>
      <row id="Pictures and binary data: {pictures} pictures, {binary} binary rows, {linked} linked files" created="20261120233557" note="Custom data (pictures, binary data)" notereadonly="1">
        <native>Pictures and binary data: {pictures} pictures, {binary} binary rows, {linked} linked files</native>
        <lang id="de" date="20261120233557" status="3">Bilder und Binärdaten: {pictures} Bilder, {binary} Binärzeilen, {linked} verknüpfte Dateien</lang>
      </row>
    </node>
  </source>
