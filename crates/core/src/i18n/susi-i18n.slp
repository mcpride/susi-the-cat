  <source class="TTsvSource" name="de-workflow.tsv" original="en" date="20261116220228">
    <outputfile dir="." localized="&lt;iso&gt;-workflow.&lt;ext&gt;"/>
    <node class="TTsvNode" name="de-workflow.tsv" state="0" created="20261112175203">
      <row id="A fixed version is checked out. Get the translation project to continue working." created="20261112175203">
        <native>A fixed version is checked out. Get the translation project to continue working.</native>
        <lang id="de" date="20261112175203" status="3">Eine feste Version ist ausgecheckt. Holen Sie das Übersetzungsprojekt, um weiterzuarbeiten.</lang>
      </row>
      <row id="A newer version is available on the server: get the translation project." created="20261112175203">
        <native>A newer version is available on the server: get the translation project.</native>
        <lang id="de" date="20261112175203" status="3">Auf dem Server gibt es eine neuere Version: Holen Sie das Übersetzungsprojekt.</lang>
      </row>
      <row id="A personal branch is created for your changes." created="20261112175203">
        <native>A personal branch is created for your changes.</native>
        <lang id="de" date="20261112175203" status="3">Für Ihre Änderungen wird ein persönlicher Zweig angelegt.</lang>
      </row>
      <row id="Access token (input is visible; end with Enter):" created="20261112175203">
        <native>Access token (input is visible; end with Enter):</native>
        <lang id="de" date="20261112175203" status="3">Zugriffstoken (Eingabe ist sichtbar; mit Enter abschließen):</lang>
      </row>
      <row id="Access token stored, signed in as {user}." created="20261112175203">
        <native>Access token stored, signed in as {user}.</native>
        <lang id="de" date="20261112175203" status="3">Zugriffstoken gespeichert, angemeldet als {user}.</lang>
      </row>
      <row id="Access token:" created="20261112175203">
        <native>Access token:</native>
        <lang id="de" date="20261112175203" status="3">Zugriffstoken:</lang>
      </row>
      <row id="Access token: available" created="20261112175203">
        <native>Access token: available</native>
        <lang id="de" date="20261112175203" status="3">Zugriffstoken: vorhanden</lang>
      </row>
      <row id="Access token: missing (susi-cli workflow login)" created="20261112175203">
        <native>Access token: missing (susi-cli workflow login)</native>
        <lang id="de" date="20261112175203" status="3">Zugriffstoken: fehlt (susi-cli workflow login)</lang>
      </row>
      <row id="Add reviewer…" created="20261112175203">
        <native>Add reviewer…</native>
        <lang id="de" date="20261112175203" status="3">Prüfer hinzufügen…</lang>
      </row>
      <row id="Advanced settings" created="20261112175203">
        <native>Advanced settings</native>
        <lang id="de" date="20261112175203" status="3">Erweiterte Einstellungen</lang>
      </row>
      <row id="An access token is already stored." created="20261112175203">
        <native>An access token is already stored.</native>
        <lang id="de" date="20261112175203" status="3">Es ist bereits ein Zugriffstoken gespeichert.</lang>
      </row>
      <row id="Asking the server…" created="20261112175203">
        <native>Asking the server…</native>
        <lang id="de" date="20261112175203" status="3">Server wird abgefragt…</lang>
      </row>
      <row id="Branch:" created="20261112175203">
        <native>Branch:</native>
        <lang id="de" date="20261112175203" status="3">Zweig:</lang>
      </row>
      <row id="Branch: {branch} (default branch: {default})" created="20261112175203">
        <native>Branch: {branch} (default branch: {default})</native>
        <lang id="de" date="20261112175203" status="3">Zweig: {branch} (Standardzweig: {default})</lang>
      </row>
      <row id="Build the localized files first" created="20261112175203">
        <native>Build the localized files first</native>
        <lang id="de" date="20261112175203" status="3">Vorher die lokalisierten Dateien erstellen</lang>
      </row>
      <row id="Changes not saved on the server" created="20261112175203">
        <native>Changes not saved on the server</native>
        <lang id="de" date="20261112175203" status="3">Änderungen nicht auf dem Server gespeichert</lang>
      </row>
      <row id="Changes saved on the server ({branch}): {message}" created="20261112175203">
        <native>Changes saved on the server ({branch}): {message}</native>
        <lang id="de" date="20261112175203" status="3">Änderungen auf dem Server gespeichert ({branch}): {message}</lang>
      </row>
      <row id="Checking git working copy…" created="20261112175203">
        <native>Checking git working copy…</native>
        <lang id="de" date="20261112175203" status="3">Git-Arbeitskopie wird geprüft…</lang>
      </row>
      <row id="Checking state…" created="20261112175203">
        <native>Checking state…</native>
        <lang id="de" date="20261112175203" status="3">Zustand wird geprüft…</lang>
      </row>
      <row id="Click to refresh (asks the server)." created="20261112175203">
        <native>Click to refresh (asks the server).</native>
        <lang id="de" date="20261112175203" status="3">Klicken zum Aktualisieren (fragt den Server).</lang>
      </row>
      <row id="Combine the commits when merging (squash)" created="20261112175203">
        <native>Combine the commits when merging (squash)</native>
        <lang id="de" date="20261112175203" status="3">Commits beim Zusammenführen zusammenfassen (squash)</lang>
      </row>
      <row id="Configuration file: {path}" created="20261112175203">
        <native>Configuration file: {path}</native>
        <lang id="de" date="20261112175203" status="3">Konfigurationsdatei: {path}</lang>
      </row>
      <row id="Connection to {url} failed: {error}" created="20261112175203">
        <native>Connection to {url} failed: {error}</native>
        <lang id="de" date="20261112175203" status="3">Verbindung zu {url} fehlgeschlagen: {error}</lang>
      </row>
      <row id="Corrected translations (fix)" created="20261112175203">
        <native>Corrected translations (fix)</native>
        <lang id="de" date="20261112175203" status="3">Korrigierte Übersetzungen (fix)</lang>
      </row>
      <row id="Create a personal access token with the scope &quot;api&quot; in GitLab (user settings, access tokens) and paste it here. It is stored in the credential manager of the operating system, not in the project." created="20261112175203">
        <native>Create a personal access token with the scope "api" in GitLab (user settings, access tokens) and paste it here. It is stored in the credential manager of the operating system, not in the project.</native>
        <lang id="de" date="20261112175203" status="3">Erstellen Sie in GitLab ein persönliches Zugriffstoken mit dem Bereich „api“ (Benutzereinstellungen, Zugriffstokens) und fügen Sie es hier ein. Es wird in der Anmeldeinformationsverwaltung des Betriebssystems gespeichert, nicht im Projekt.</lang>
      </row>
      <row id="Create a fine-grained personal access token in GitHub (Settings, Developer settings, Personal access tokens) for this repository with the repository permissions &quot;Contents&quot; and &quot;Pull requests&quot; (read and write) and paste it here. It is stored in the credential manager of the operating system, not in the project." created="20261115140835">
        <native>Create a fine-grained personal access token in GitHub (Settings, Developer settings, Personal access tokens) for this repository with the repository permissions "Contents" and "Pull requests" (read and write) and paste it here. It is stored in the credential manager of the operating system, not in the project.</native>
        <lang id="de" date="20261115140835" status="3">Erstellen Sie in GitHub ein feingranulares persönliches Zugriffstoken (Settings, Developer settings, Personal access tokens) für dieses Repository mit den Repository-Berechtigungen „Contents“ und „Pull requests“ (Lesen und Schreiben) und fügen Sie es hier ein. Es wird in der Anmeldeinformationsverwaltung des Betriebssystems gespeichert, nicht im Projekt.</lang>
      </row>
      <row id="Create merge request" created="20261112175203">
        <native>Create merge request</native>
        <lang id="de" date="20261112175203" status="3">Merge Request erstellen</lang>
      </row>
      <row id="Create pull request" created="20261115140835">
        <native>Create pull request</native>
        <lang id="de" date="20261115140835" status="3">Pull Request erstellen</lang>
      </row>
      <row id="Creates a merge request: a reviewer checks your changes and adopts them." created="20261112175203">
        <native>Creates a merge request: a reviewer checks your changes and adopts them.</native>
        <lang id="de" date="20261112175203" status="3">Erstellt einen Merge Request: Ein Prüfer kontrolliert Ihre Änderungen und übernimmt sie.</lang>
      </row>
      <row id="Creates a pull request: a reviewer checks your changes and adopts them." created="20261115140835">
        <native>Creates a pull request: a reviewer checks your changes and adopts them.</native>
        <lang id="de" date="20261115140835" status="3">Erstellt einen Pull Request: Ein Prüfer kontrolliert Ihre Änderungen und übernimmt sie.</lang>
      </row>
      <row id="Creates the configuration template .susi/workflow.toml." created="20261112175203">
        <native>Creates the configuration template .susi/workflow.toml.</native>
        <lang id="de" date="20261112175203" status="3">Legt die Konfigurationsvorlage .susi/workflow.toml an.</lang>
      </row>
      <row id="Default branch: {branch}" created="20261112175203">
        <native>Default branch: {branch}</native>
        <lang id="de" date="20261112175203" status="3">Standardzweig: {branch}</lang>
      </row>
      <row id="Delete the branch after merging" created="20261112175203">
        <native>Delete the branch after merging</native>
        <lang id="de" date="20261112175203" status="3">Zweig nach dem Zusammenführen löschen</lang>
      </row>
      <row id="Description:" created="20261112175203">
        <native>Description:</native>
        <lang id="de" date="20261112175203" status="3">Beschreibung:</lang>
      </row>
      <row id="Fixed version" created="20261112175203">
        <native>Fixed version</native>
        <lang id="de" date="20261112175203" status="3">Feste Version</lang>
      </row>
      <row id="Get" created="20261112175203">
        <native>Get</native>
        <lang id="de" date="20261112175203" status="3">Holen</lang>
      </row>
      <row id="Get translation project" created="20261112175203">
        <native>Get translation project</native>
        <lang id="de" date="20261112175203" status="3">Übersetzungsprojekt holen</lang>
      </row>
      <row id="Get translation project: latest version from the server" created="20261112175203">
        <native>Get translation project: latest version from the server</native>
        <lang id="de" date="20261112175203" status="3">Übersetzungsprojekt holen: neueste Version vom Server</lang>
      </row>
      <row id="Get translation project: sets local changes aside and checks out\nthe latest version of the default branch." created="20261112175203">
        <native>Get translation project: sets local changes aside and checks out#lthe latest version of the default branch.</native>
        <lang id="de" date="20261112175203" status="3">Übersetzungsprojekt holen: legt lokale Änderungen beiseite und checkt#ldie neueste Version des Standardzweigs aus.</lang>
      </row>
      <row id="Get translation project…" created="20261112175203">
        <native>Get translation project…</native>
        <lang id="de" date="20261112175203" status="3">Übersetzungsprojekt holen…</lang>
      </row>
      <row id="Gets the latest version of the translation project from the server and opens it." created="20261112175203">
        <native>Gets the latest version of the translation project from the server and opens it.</native>
        <lang id="de" date="20261112175203" status="3">Holt die neueste Version des Übersetzungsprojekts vom Server und öffnet sie.</lang>
      </row>
      <row id="Getting translation project…" created="20261112175203">
        <native>Getting translation project…</native>
        <lang id="de" date="20261112175203" status="3">Übersetzungsprojekt wird geholt…</lang>
      </row>
      <row id="Git workflow active ({path}): {state}" created="20261112175203">
        <native>Git workflow active ({path}): {state}</native>
        <lang id="de" date="20261112175203" status="3">Git-Workflow aktiv ({path}): {state}</lang>
      </row>
      <row id="Git workflow for translators (configuration: .susi/workflow.toml, see README).\nActions are run in the given order (default: status):" created="20261112175203">
        <native>Git workflow for translators (configuration: .susi/workflow.toml, see README).#lActions are run in the given order (default: status):</native>
        <lang id="de" date="20261112175203" status="3">Git-Workflow für Übersetzer (Konfiguration: .susi/workflow.toml, siehe README).#lAktionen werden in der angegebenen Reihenfolge ausgeführt (Standard: status):</lang>
      </row>
      <row id="Git workflow: get, save and publish translations" created="20261112175203">
        <native>Git workflow: get, save and publish translations</native>
        <lang id="de" date="20261112175203" status="3">Git-Workflow: Übersetzungen holen, zwischenspeichern und veröffentlichen</lang>
      </row>
      <row id="In review" created="20261112175203">
        <native>In review</native>
        <lang id="de" date="20261112175203" status="3">In Prüfung</lang>
      </row>
      <row id="Invalid access token" created="20261112175203">
        <native>Invalid access token</native>
        <lang id="de" date="20261112175203" status="3">Ungültiges Zugriffstoken</lang>
      </row>
      <row id="Invalid branch name &quot;{name}&quot;" created="20261112175203">
        <native>Invalid branch name "{name}"</native>
        <lang id="de" date="20261112175203" status="3">Ungültiger Zweigname "{name}"</lang>
      </row>
      <row id="Invalid token reference &quot;{value}&quot; (allowed: auto, env:NAME, credential, credential:USER, none). Never put the token itself into a configuration file." created="20261112175203">
        <native>Invalid token reference "{value}" (allowed: auto, env:NAME, credential, credential:USER, none). Never put the token itself into a configuration file.</native>
        <lang id="de" date="20261112175203" status="3">Ungültige Token-Referenz "{value}" (erlaubt: auto, env:NAME, credential, credential:USER, none). Tragen Sie niemals das Token selbst in eine Konfigurationsdatei ein.</lang>
      </row>
      <row id="Kind of change:" created="20261112175203">
        <native>Kind of change:</native>
        <lang id="de" date="20261112175203" status="3">Art der Änderung:</lang>
