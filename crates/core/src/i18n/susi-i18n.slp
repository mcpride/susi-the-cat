      <row id="Stores the access token (read from stdin) with git's credential helper." state="0" created="20261112175203">
        <native>Stores the access token (read from stdin) with git's credential helper.</native>
        <lang id="de" date="20261112175203" status="3">Speichert das Zugriffstoken (von stdin gelesen) mit dem Credential-Helper von git.</lang>
      </row>
      <row id="Target branch:" state="0" created="20261112175203">
        <native>Target branch:</native>
        <lang id="de" date="20261112175203" status="3">Zielzweig:</lang>
      </row>
      <row id="The access token has no permission for this action (scope &quot;api&quot; and at least the role Developer are required)." state="0" created="20261112175203">
        <native>The access token has no permission for this action (scope "api" and at least the role Developer are required).</native>
        <lang id="de" date="20261112175203" status="3">Das Zugriffstoken hat keine Berechtigung für diese Aktion (benötigt werden der Bereich "api" und mindestens die Rolle Developer).</lang>
      </row>
      <row id="The access token is missing, invalid or expired. Store a token with the scope &quot;api&quot; (Workflow &gt; Sign in to the server…) or set {env}." state="0" created="20261112175203">
        <native>The access token is missing, invalid or expired. Store a token with the scope "api" (Workflow &gt; Sign in to the server…) or set {env}.</native>
        <lang id="de" date="20261112175203" status="3">Das Zugriffstoken fehlt, ist ungültig oder abgelaufen. Speichern Sie ein Token mit dem Bereich "api" (Workflow &gt; Am Server anmelden…) oder setzen Sie {env}.</lang>
      </row>
      <row id="The branch &quot;{branch}&quot; does not exist on the server" state="0" created="20261112175203">
        <native>The branch "{branch}" does not exist on the server</native>
        <lang id="de" date="20261112175203" status="3">Der Zweig "{branch}" existiert nicht auf dem Server</lang>
      </row>
      <row id="The branch &quot;{branch}&quot; was already published and removed on the server. Get the translation project first." state="0" created="20261112175203">
        <native>The branch "{branch}" was already published and removed on the server. Get the translation project first.</native>
        <lang id="de" date="20261112175203" status="3">Der Zweig "{branch}" wurde bereits veröffentlicht und auf dem Server entfernt. Holen Sie zuerst das Übersetzungsprojekt.</lang>
      </row>
      <row id="The branch pattern must not be empty" state="0" created="20261112175203">
