  <source class="TTsvSource" name="de-cli.tsv" original="en" date="20261127162647">
    <outputfile dir="." localized="&lt;iso&gt;-cli.&lt;ext&gt;"/>
    <node class="TTsvNode" name="de-cli.tsv" state="0" created="20261103155355">
      <row id="susi-cli {version} – Susi the CAT (SlMake compatible)" created="20261103162607" note="Help: general" notereadonly="1">
        <native>susi-cli {version} – Susi the CAT (SlMake compatible)</native>
        <lang id="de" date="20261103162607" status="3">susi-cli {version} – Susi the CAT (SlMake-kompatibel)</lang>
      </row>
      <row id="&lt;tasks&gt; contains one or more tasks with their options:" created="20261103155355" note="Help: general" notereadonly="1">
        <native>&lt;tasks&gt; contains one or more tasks with their options:</native>
        <lang id="de" date="20261103155355" status="3">&lt;tasks&gt; enthält einen oder mehrere Tasks mit ihren Optionen:</lang>
      </row>
      <row id="Add a source (creates the project if needed)" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Add a source (creates the project if needed)</native>
        <lang id="de" date="20261103155355" status="3">Quelle hinzufügen (legt das Projekt bei Bedarf an)</lang>
      </row>
      <row id="Create localized files (alias: build, make)" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Create localized files (alias: build, make)</native>
        <lang id="de" date="20261103155355" status="3">Lokalisierte Dateien erstellen (Alias: build, make)</lang>
      </row>
      <row id="Translate duplicate strings" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Translate duplicate strings</native>
        <lang id="de" date="20261103155355" status="3">Doppelte Zeichenfolgen übersetzen</lang>
      </row>
      <row id="Export data to a file (.xlsx, .csv, .txt, .xlf, .tmx)" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Export data to a file (.xlsx, .csv, .txt, .xlf, .tmx)</native>
        <lang id="de" date="20261103155355" status="3">Daten in eine Datei exportieren (.xlsx, .csv, .txt, .xlf, .tmx)</lang>
      </row>
      <row id="Insert pseudo translation" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Insert pseudo translation</native>
        <lang id="de" date="20261103155355" status="3">Pseudo-Übersetzung einfügen</lang>
      </row>
      <row id="Import translations from a file" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Import translations from a file</native>
        <lang id="de" date="20261103155355" status="3">Übersetzungen aus einer Datei importieren</lang>
      </row>
      <row id="Remove unused items" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Remove unused items</native>
        <lang id="de" date="20261103155355" status="3">Unbenutzte Einträge entfernen</lang>
      </row>
      <row id="Remove pseudo translation" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Remove pseudo translation</native>
        <lang id="de" date="20261103155355" status="3">Pseudo-Übersetzung entfernen</lang>
      </row>
      <row id="Create a project report (.html, .txt, .json)" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Create a project report (.html, .txt, .json)</native>
        <lang id="de" date="20261103155355" status="3">Projektbericht erstellen (.html, .txt, .json)</lang>
      </row>
      <row id="Scan the project" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Scan the project</native>
        <lang id="de" date="20261103155355" status="3">Projekt scannen</lang>
      </row>
      <row id="Translate with the translation memory" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Translate with the translation memory</native>
        <lang id="de" date="20261103155355" status="3">Mit dem Translation Memory übersetzen</lang>
      </row>
      <row id="Validate translations" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Validate translations</native>
        <lang id="de" date="20261103155355" status="3">Übersetzungen prüfen</lang>
      </row>
      <row id="Save translations to the translation memory" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Save translations to the translation memory</native>
        <lang id="de" date="20261103155355" status="3">Übersetzungen im Translation Memory speichern</lang>
      </row>
      <row id="Show languages, sources and progress" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Show languages, sources and progress</native>
        <lang id="de" date="20261103155355" status="3">Sprachen, Quellen und Fortschritt anzeigen</lang>
      </row>
      <row id="Start the MCP server (stdio) for AI agents" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Start the MCP server (stdio) for AI agents</native>
        <lang id="de" date="20261103155355" status="3">MCP-Server (stdio) für KI-Agenten starten</lang>
      </row>
      <row id="Without a task, 'create' is run." created="20261103155355" note="Help: general" notereadonly="1">
        <native>Without a task, 'create' is run.</native>
        <lang id="de" date="20261103155355" status="3">Ohne Task wird 'create' ausgeführt.</lang>
      </row>
      <row id="Options:" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Options:</native>
        <lang id="de" date="20261103155355" status="3">Optionen:</lang>
      </row>
      <row id="Quiet mode. Only errors are shown." created="20261103155355" note="Help: general" notereadonly="1">
        <native>Quiet mode. Only errors are shown.</native>
        <lang id="de" date="20261103155355" status="3">Stiller Modus. Nur Fehler werden ausgegeben.</lang>
      </row>
      <row id="ANSI mode (accepted; susi always writes UTF-8)." created="20261103155355" note="Help: general" notereadonly="1">
        <native>ANSI mode (accepted; susi always writes UTF-8).</native>
        <lang id="de" date="20261103155355" status="3">ANSI-Modus (wird akzeptiert; susi gibt immer UTF-8 aus).</lang>
      </row>
      <row id="Result code 2 on errors, 1 on warnings, otherwise 0.\nWithout -w: 1 on errors, otherwise 0." created="20261103155355" note="Help: general" notereadonly="1">
        <native>Result code 2 on errors, 1 on warnings, otherwise 0.#lWithout -w: 1 on errors, otherwise 0.</native>
        <lang id="de" date="20261103155355" status="3">Rückgabewert 2 bei Fehlern, 1 bei Warnungen, sonst 0.#lOhne -w: 1 bei Fehlern, sonst 0.</lang>
      </row>
      <row id="Show detailed error information." created="20261103155355" note="Help: general" notereadonly="1">
        <native>Show detailed error information.</native>
        <lang id="de" date="20261103155355" status="3">Detaillierte Fehlerinformationen anzeigen.</lang>
      </row>
      <row id="Show help for a task, e.g. susi-cli export -h" created="20261103155355" note="Help: general" notereadonly="1">
        <native>Show help for a task, e.g. susi-cli export -h</native>
        <lang id="de" date="20261103155355" status="3">Hilfe zu einem Task anzeigen, z. B. susi-cli export -h</lang>
      </row>
      <row id="Do not save the project file, even if it was changed." created="20261103155355" note="Help: general" notereadonly="1">
        <native>Do not save the project file, even if it was changed.</native>
        <lang id="de" date="20261103155355" status="3">Projektdatei nicht speichern, auch wenn sie geändert wurde.</lang>
      </row>
      <row id="Save the project file even after an error." created="20261103155355" note="Help: general" notereadonly="1">
        <native>Save the project file even after an error.</native>
        <lang id="de" date="20261103155355" status="3">Projektdatei auch nach einem Fehler speichern.</lang>
      </row>
      <row id="Language of help and messages: en, de or auto (SUSI_LANG or system language).\nDefault: environment variable SUSI_LANG, then the language setting of\nthe Susi GUI, then the system language." created="20261103155355" note="Help: general" notereadonly="1">
        <native>Language of help and messages: en, de or auto (SUSI_LANG or system language).#lDefault: environment variable SUSI_LANG, then the language setting of#lthe Susi GUI, then the system language.</native>
        <lang id="de" date="20261103155355" status="3">Sprache von Hilfe und Meldungen: en, de oder auto (SUSI_LANG oder Systemsprache).#lStandard: Umgebungsvariable SUSI_LANG, dann die Spracheinstellung#lder Susi-Oberfläche, dann die Systemsprache.</lang>
      </row>
      <row id="Options can also be given in the form --lang=de,fr." created="20261103155355" note="Help: general" notereadonly="1">
        <native>Options can also be given in the form --lang=de,fr.</native>
        <lang id="de" date="20261103155355" status="3">Optionen können auch in der Form --lang=de,fr angegeben werden.</lang>
      </row>
      <row id="Language codes separated by ; (e.g. de;fr-CA). Default: all languages." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Language codes separated by ; (e.g. de;fr-CA). Default: all languages.</native>
        <lang id="de" date="20261103155355" status="3">Sprachcodes, getrennt durch ; (z. B. de;fr-CA). Standard: alle Sprachen.</lang>
      </row>
      <row id="Translation statuses, separated by ;:" created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Translation statuses, separated by ;:</native>
        <lang id="de" date="20261103155355" status="3">Übersetzungsstatus, getrennt durch ;:</lang>
      </row>
      <row id="Only these sources (names, separated by ;)." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Only these sources (names, separated by ;).</native>
        <lang id="de" date="20261103155355" status="3">Nur diese Quellen (Namen, getrennt durch ;).</lang>
      </row>
      <row id="Skip these sources." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Skip these sources.</native>
        <lang id="de" date="20261103155355" status="3">Diese Quellen auslassen.</lang>
      </row>
      <row id="Replace existing translations." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Replace existing translations.</native>
        <lang id="de" date="20261103155355" status="3">Vorhandene Übersetzungen ersetzen.</lang>
      </row>
      <row id="Example:" created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Example:</native>
        <lang id="de" date="20261103155355" status="3">Beispiel:</lang>
      </row>
      <row id="Examples:" created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Examples:</native>
        <lang id="de" date="20261103155355" status="3">Beispiele:</lang>
      </row>
      <row id="Adds sources (.json, .resx/.resw, .po/.pot, .tsv, .properties, Android .xml, .arb, Qt .ts,\n_locales/&lt;lang&gt;/messages.json; wildcards * and ? allowed) and scans them. If the project does not\nexist, it is created." created="20261115131719" note="Help: tasks" notereadonly="1">
        <native>Adds sources (.json, .resx/.resw, .po/.pot, .tsv, .properties, Android .xml, .arb, Qt .ts,#l_locales/&lt;lang&gt;/messages.json; wildcards * and ? allowed) and scans them. If the project does not#lexist, it is created.</native>
        <lang id="de" date="20261115131719" status="3">Fügt Quellen (.json, .resx/.resw, .po/.pot, .tsv, .properties, Android-.xml, .arb, Qt-.ts,#l_locales/&lt;lang&gt;/messages.json; Platzhalter * und ? erlaubt) hinzu und scannt sie. Existiert das Projekt#lnicht, wird es angelegt.</lang>
      </row>
      <row id="Original language of the source (default: en)." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Original language of the source (default: en).</native>
        <lang id="de" date="20261103155355" status="3">Originalsprache der Quelle (Standard: en).</lang>
      </row>
      <row id="json, resx, po, tsv, properties, android, arb, webext or ts (default: by file name)." created="20261115131719" note="Help: tasks" notereadonly="1">
        <native>json, resx, po, tsv, properties, android, arb, webext or ts (default: by file name).</native>
        <lang id="de" date="20261115131719" status="3">json, resx, po, tsv, properties, android, arb, webext oder ts (Standard: anhand des Dateinamens).</lang>
      </row>
      <row id="Creates the localized files (Project | Build)." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Creates the localized files (Project | Build).</native>
        <lang id="de" date="20261103155355" status="3">Erstellt die lokalisierten Dateien (Projekt | Erstellen).</lang>
      </row>
      <row id="Translates duplicate strings with existing translations of the same original." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Translates duplicate strings with existing translations of the same original.</native>
        <lang id="de" date="20261103155355" status="3">Übersetzt doppelte Zeichenfolgen mit bereits vorhandenen Übersetzungen desselben Originals.</lang>
      </row>
      <row id="Exports rows to a file: .xlsx (Excel), .csv, .txt (tab separated), .xlf/.xliff, .tmx.\nXLIFF with several languages creates one file per language (name.&lt;language&gt;.xlf)." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Exports rows to a file: .xlsx (Excel), .csv, .txt (tab separated), .xlf/.xliff, .tmx.#lXLIFF with several languages creates one file per language (name.&lt;language&gt;.xlf).</native>
        <lang id="de" date="20261103155355" status="3">Exportiert Zeilen in eine Datei: .xlsx (Excel), .csv, .txt (Tab-getrennt), .xlf/.xliff, .tmx.#lXLIFF mit mehreren Sprachen erzeugt je Sprache eine Datei (name.&lt;sprache&gt;.xlf).</lang>
      </row>
      <row id="Row status:" created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Row status:</native>
        <lang id="de" date="20261103155355" status="3">Zeilenstatus:</lang>
      </row>
      <row id="true = also export &quot;Do not translate&quot; rows" created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>true = also export "Do not translate" rows</native>
        <lang id="de" date="20261103155355" status="3">true = auch "Nicht übersetzen"-Zeilen exportieren</lang>
      </row>
      <row id="Imports translations from .xlsx, .csv, .txt, .xlf/.xliff or .tmx.\nRows are matched by source+context, then context, then original text.\nRows marked &quot;Do not translate&quot; and excluded rows are skipped." state="0" created="20261127154136" note="Help: tasks" notereadonly="1">
        <native>Imports translations from .xlsx, .csv, .txt, .xlf/.xliff or .tmx.#lRows are matched by source+context, then context, then original text.#lRows marked "Do not translate" and excluded rows are skipped.</native>
        <lang id="de" date="20261127154136" status="3">Importiert Übersetzungen aus .xlsx, .csv, .txt, .xlf/.xliff oder .tmx.#lZeilen werden über Quelle+Kontext, dann Kontext, dann Originaltext zugeordnet.#lZeilen mit „Nicht übersetzen“ und ausgeschlossene Zeilen werden übersprungen.</lang>
      </row>
      <row id="Overwrite existing translations: 0 = never, 1..3 = yes (default)" created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Overwrite existing translations: 0 = never, 1..3 = yes (default)</native>
        <lang id="de" date="20261103155355" status="3">Vorhandene Übersetzungen überschreiben: 0 = nie, 1..3 = ja (Standard)</lang>
      </row>
      <row id="Status of imported texts without a status column:\n1 = Best guess, 2 = Auto translated, 3 = Translated (default),\n4 = For review, 5 = Complete" created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Status of imported texts without a status column:#l1 = Best guess, 2 = Auto translated, 3 = Translated (default),#l4 = For review, 5 = Complete</native>
        <lang id="de" date="20261103155355" status="3">Status importierter Texte ohne Statusspalte:#l1 = Vorschlag, 2 = Automatisch übersetzt, 3 = Übersetzt (Standard),#l4 = Zur Prüfung, 5 = Abgeschlossen</lang>
      </row>
      <row id="Import even if the original has changed." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Import even if the original has changed.</native>
        <lang id="de" date="20261103155355" status="3">Auch importieren, wenn sich das Original geändert hat.</lang>
      </row>
      <row id="Do not import comments." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Do not import comments.</native>
        <lang id="de" date="20261103155355" status="3">Keine Kommentare importieren.</lang>
      </row>
      <row id="Fills empty cells with pseudo translations (Column | Pseudo translation).\nUnknown languages are added as pseudo languages." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Fills empty cells with pseudo translations (Column | Pseudo translation).#lUnknown languages are added as pseudo languages.</native>
        <lang id="de" date="20261103155355" status="3">Füllt leere Zellen mit Pseudo-Übersetzungen (Spalte | Pseudo-Übersetzung).#lUnbekannte Sprachen werden als Pseudo-Sprache angelegt.</lang>
      </row>
      <row id="Also replace existing translations." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Also replace existing translations.</native>
        <lang id="de" date="20261103155355" status="3">Auch vorhandene Übersetzungen ersetzen.</lang>
      </row>
      <row id="Removes pseudo translations." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Removes pseudo translations.</native>
        <lang id="de" date="20261103155355" status="3">Entfernt Pseudo-Übersetzungen.</lang>
      </row>
      <row id="Removes unused rows (Project | Remove unused items)." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Removes unused rows (Project | Remove unused items).</native>
        <lang id="de" date="20261103155355" status="3">Entfernt unbenutzte Zeilen (Projekt | Unbenutzte Einträge entfernen).</lang>
      </row>
      <row id="Creates a project report. Format by extension: .html, .txt, .json; without a file: output to stdout." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Creates a project report. Format by extension: .html, .txt, .json; without a file: output to stdout.</native>
        <lang id="de" date="20261103155355" status="3">Erstellt einen Projektbericht. Format nach Endung: .html, .txt, .json; ohne Datei: Ausgabe auf stdout.</lang>
      </row>
      <row id="Scans the sources (new, changed and unused strings)." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Scans the sources (new, changed and unused strings).</native>
        <lang id="de" date="20261103155355" status="3">Scannt die Quellen (neue, geänderte und unbenutzte Zeichenfolgen).</lang>
      </row>
      <row id="Translates untranslated rows from the translation memory (TMX).\nExact matches get the status &quot;Auto translated&quot;, fuzzy ones &quot;Best guess&quot;." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Translates untranslated rows from the translation memory (TMX).#lExact matches get the status "Auto translated", fuzzy ones "Best guess".</native>
        <lang id="de" date="20261103155355" status="3">Übersetzt nicht übersetzte Zeilen aus dem Translation Memory (TMX).#lExakte Treffer erhalten den Status "Automatisch übersetzt", unscharfe "Vorschlag".</lang>
      </row>
      <row id="TMX file (default: settings, %APPDATA%\\susi\\susi-tm.tmx)" created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>TMX file (default: settings, %APPDATA%\susi\susi-tm.tmx)</native>
        <lang id="de" date="20261103155355" status="3">TMX-Datei (Standard: Einstellungen, %APPDATA%\susi\susi-tm.tmx)</lang>
      </row>
      <row id="Use fuzzy matches from N % (50..100)." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Use fuzzy matches from N % (50..100).</native>
        <lang id="de" date="20261103155355" status="3">Unscharfe Treffer ab N % (50..100) verwenden.</lang>
      </row>
      <row id="Only &quot;tm&quot; is supported." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Only "tm" is supported.</native>
        <lang id="de" date="20261103155355" status="3">Nur "tm" wird unterstützt.</lang>
      </row>
      <row id="Validates translations (placeholders, tags, spaces, line breaks, punctuation, length, ...).\nErrors and warnings determine the result code (see -w)." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Validates translations (placeholders, tags, spaces, line breaks, punctuation, length, ...).#lErrors and warnings determine the result code (see -w).</native>
        <lang id="de" date="20261103155355" status="3">Prüft Übersetzungen (Platzhalter, Tags, Leerzeichen, Zeilenumbrüche, Satzzeichen, Länge, ...).#lFehler und Warnungen bestimmen den Rückgabewert (siehe -w).</lang>
      </row>
      <row id="All checks (including missing translations)." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>All checks (including missing translations).</native>
        <lang id="de" date="20261103155355" status="3">Alle Prüfungen (inkl. fehlender Übersetzungen).</lang>
      </row>
      <row id="Default checks." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Default checks.</native>
        <lang id="de" date="20261103155355" status="3">Standardprüfungen.</lang>
      </row>
      <row id="Specific checks:" created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Specific checks:</native>
        <lang id="de" date="20261103155355" status="3">Bestimmte Prüfungen:</lang>
      </row>
      <row id="Also writes the result to a JUnit XML file (e.g. for GitLab CI):\nerrors as failed tests, with -w warnings too; without findings\nthe file contains no tests." created="20261115121206" note="Help: tasks" notereadonly="1">
        <native>Also writes the result to a JUnit XML file (e.g. for GitLab CI):#lerrors as failed tests, with -w warnings too; without findings#lthe file contains no tests.</native>
        <lang id="de" date="20261115121206" status="3">Schreibt das Ergebnis zusätzlich in eine JUnit-XML-Datei (z. B. für GitLab CI):#lFehler als fehlgeschlagene Tests, mit -w auch Warnungen; ohne Befund#lenthält die Datei keine Tests.</lang>
      </row>
      <row id="Saves translations to the translation memory." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Saves translations to the translation memory.</native>
        <lang id="de" date="20261103155355" status="3">Speichert Übersetzungen im Translation Memory.</lang>
      </row>
      <row id="TMX file" created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>TMX file</native>
        <lang id="de" date="20261103155355" status="3">TMX-Datei</lang>
      </row>
      <row id="Default:" created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Default:</native>
        <lang id="de" date="20261103155355" status="3">Standard:</lang>
      </row>
      <row id="Shows languages, sources and the translation progress." created="20261103155355" note="Help: tasks" notereadonly="1">
        <native>Shows languages, sources and the translation progress.</native>
        <lang id="de" date="20261103155355" status="3">Zeigt Sprachen, Quellen und den Übersetzungsfortschritt.</lang>
      </row>
      <row id="Starts the MCP server (Model Context Protocol) on stdin/stdout for AI agents." created="20261103155355" note="Help: tasks" notereadonly="1">
