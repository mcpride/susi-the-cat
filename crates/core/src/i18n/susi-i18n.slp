        <lang id="de" date="20261118153954" status="3">Option -key fehlt (Kontexte oder Zeilen-IDs, Platzhalter * und ?)</lang>
      </row>
      <row id="No row matches the key &quot;{key}&quot;" created="20261118153954" note="Screenshots" notereadonly="1">
        <native>No row matches the key "{key}"</native>
        <lang id="de" date="20261118153954" status="3">Keine Zeile passt zum Schlüssel "{key}"</lang>
      </row>
      <row id="Screenshot added: {id}" created="20261118153954" note="Screenshots" notereadonly="1">
        <native>Screenshot added: {id}</native>
        <lang id="de" date="20261118153954" status="3">Screenshot hinzugefügt: {id}</lang>
      </row>
      <row id="Screenshot removed: {id}" created="20261118153954" note="Screenshots" notereadonly="1">
